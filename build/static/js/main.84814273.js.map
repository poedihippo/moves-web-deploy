import axios from "axios";
import React, { useEffect, useState, useMemo } from "react";
import { mainUrl, config as isConfig } from "../../../api/api";
import Button from "../../Button/Button";
import { useInfiniteQuery, QueryCache } from "react-query";

const DiscountPopup = (props) => {
  const quesryCache = new QueryCache()
  const { setAllDiscount, allDiscount, setDiscount_ids, discount_ids } = props;
  const [discounts, setDiscounts] = useState(null);
  
  const {
    status,
    data,
    error,
    isFetching,
    isFetchingNextPage,
    fetchNextPage,
    hasNextPage,
  } = useInfiniteQuery(["discounts"],({pageParam = 1}) => {
    return axios.get(`${mainUrl}/discounts?page=${pageParam}`, isConfig).then((res) => res.data).catch((error) => error.response)
  },{
    getPreviousPageParam: (firstPage) => firstPage.previousId ?? undefined,
    getNextPageParam: (lastPage) => {
      if(lastPage.links.next !== null){
        return lastPage.meta.current_page + 1
      }
      return undefined
      // console.log(lastPage, "checking las page")
      // return lastPage.meta.current_page + 1
    },
    refetchOnWindowFocus: (query) => query.state.status !== "error", 
    staleTime: Infinity
  });
  const resultDiscount = useMemo(() => {
    return dataFromPaginated(data)
  },[data])
  

  const handleClick = (discount, discount_id) => {
    // props.setDiscount(discount);
    if (!allDiscount.includes(discount)) {
      setAllDiscount([...allDiscount, discount]);
      setDiscount_ids([...discount_ids, discount_id]);
    }

    // props.setPopup(false);
 
  };


  const handleDeleteDiscount = (discount, discount_id) => {
    // let newAllDiscount = ;
    // [1,2,3,4]
    // 2
    // let newDiscount_ids = discount_ids.filter((item) => item !== discount_id);
    // [1,3,4]
    

    // console.log(newAllDiscount);
    setAllDiscount(allDiscount.filter((item) => item !== discount));
    setDiscount_ids(discount_ids.filter((item) => item !== discount_id));
  };
  if(error){
    return <h4>Terjadi Kesalahan Pada Server</h4>
  }
  return (
    (
      <div className="discount-popup" id="discount-popup" style={{zIndex: '150'}}>
        <div>
          <h2>Discount</h2>
          <div className="discount-code-form mt-4 mb-4">
            <form className="d-flex">
              <img src="/Asset/Voucher.svg" alt="voucher" />
              <input
                type="text"
                id="voucher-code"
                name="voucher-code"
                className="form-control"
                placeholder="Masukkan kode"
                style={{
                  height: "41px",
                  borderTop: "none",
                  borderRight: "none",
                  borderLeft: "none",
                  borderBottom: "1px solid dark",
                  margin: "0 10px",
                  borderRadius: "0",
                }}
              />
              <Button title="Add" icon="" btnStyle="primary-btn" />
            </form>
          </div>
          {resultDiscount?.map((discounts) => {
            return discounts?.map((discount) => {
              return (
                <div
                  className="d-flex justify-content-between align-items-center mb-3"
                  style={{
                    padding: "20px",
                    border: "1px solid #000",
                    borderRadius: "4px",
                  }}
                  key={discount.id}
                >
                  <div>
                    <p>{discount.name}</p>
                    <p>{discount.description}</p>
                  </div>
                  <div>
                    {allDiscount.includes(discount) ? (
                      <div
                        onClick={() =>
                          handleDeleteDiscount(discount, discount.id)
                        }
                      >
                        <Button title={"Delete"} btnStyle={"btn-danger"} />
                      </div>
                    ) : (
                      <div onClick={() => handleClick(discount, discount.id)}>
                        <Button title={"Apply"} btnStyle={"primary-btn"} />
                      </div>
                    )}
                  </div>
                </div>
              );
            })
          })}
          <div style={{width:"max-content", margin:"20px auto"}}>
            <Button title={hasNextPage ? "Load More" : "Nothing more to load"} btnWidth={"max-content"} btnStyle={"primary-btn"} onClick={() => fetchNextPage()} disabled={hasNextPage ? false : true}/>
          </div>
          <div onClick={() => props.setPopup(false)}>
            <Button title="Done" btnStyle={"primary-btn"} btnWidth="100%" />
          </div>
        </div>
      </div>
    )
  );
};

export default DiscountPopup;


const dataFromPaginated = (
  paginationData
) => {
  if (!paginationData) return null;
  // @ts-ignore
  const newArr = [];
  // newArr.push(paginationData.data);
  paginationData?.pages?.forEach((d) => {
    newArr.push(d.data)
  });
  return newArr
  // console.log(newArr, "check new arr yah")
  // return paginationData?.pages.reduce(
  //   (acc, group) => [...acc, ...group.data],
  //   []
  // );
}