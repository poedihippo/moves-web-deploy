import React, {useEffect, useState} from 'react';
import Axios from 'axios';
import { mainUrl } from '../../../api/api';
import moment from 'moment';
import LoadedComponent from '../../Loaded/LoadedComponent';
import { formatCurrency } from '../../../api/format';
const BrandDetails = ({isUser, idComp, filterDate, isReport}) => {

    let today = new Date()
    let currentMonth = ("0" + (today.getMonth() + 1)).slice(-2);
    const startDate = moment(`${today.getFullYear()}-${currentMonth}`).startOf("month").format("YYYY-MM-DD");
    const endDate = moment(`${today.getFullYear()}-${currentMonth}`).endOf("month").format("YYYY-MM-DD");
    const companies = [
        {
            name:"MELANDAS",
            id:1
        },
        {
            name:"DIO LIVING",
            id:2
        }
    ]
    const [isLoading, setIsLoading] = useState(true)
    const [isData, setIsData] = useState([]);
    useEffect(() => {
        setIsLoading(true)
        const config = {
            headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${localStorage.token}`,
            },
        };
        const getDataBrand = async () => {
            Axios.get(`${mainUrl}/new-reports/brand-details?company_id=${idComp ?? ""}&end_date=${filterDate?.end === "" ? endDate : filterDate?.end}&start_date=${filterDate?.start === "" ? startDate : filterDate?.start}`, config)
            .then(data => {
                setIsLoading(false)
                setIsData(data.data.brand_details)
            })
            .catch(error => console.log(error.response))
        }   

        isUser !== undefined && getDataBrand();
    }, [isUser, idComp, filterDate])

    return (
        <>
            <div className='brand-details' style={{marginTop: "25px"}}>
                <div className='ctn d-flex flex-row justify-content-between'>
                    <h3 style={{fontWeight: "600"}}>{isReport !== "" ? isUser?.data?.name :companies[idComp - 1]?.name}</h3>
                    <div className='date d-flex flex-column'>
                        <span>Start: {filterDate?.start === "" ? startDate : filterDate?.start}</span>
                        <span>End: {filterDate?.end === "" ? endDate : filterDate?.end}</span>
                    </div>
                </div>
                {
                    !isLoading  ? isData.map((res,i) => {
                        return(
                            <div class="card h-max" style={{margin: "20px 0", height:"max-content"}}>
                                <div class="card-header" style={{backgroundColor: "white", position:"relative"}}>
                                    <h4 className='text-start' style={{fontSize: "18px", fontWeight:"bold"}}>{res?.product_brand} <span style={{fontSize: "11px", marginLeft: "10px", color: res?.brand_category?.toUpperCase() === "PREMIUM" ? "#FFD13D": "#17949d"}}>{res?.brand_category}</span></h4>
                                    <div style={{position: "absolute", top:"0", right:0, backgroundColor: "#17949d", padding: "5px 7px", fontSize: "12px", color:"white", borderRadius: "0 0 0 10px"}}>{companies[idComp - 1]?.name}</div>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-horizontal border-0 justify-content-around" style={{fontSize:"13px"}}>
                                        <li class="list-group-item d-flex flex-column border-0" >
                                            <span className="d-block ">Order Value</span>
                                            <span className="d-block " style={{color: "#17949d", fontWeight:"bold"}}>{formatCurrency(res?.order_value, true)}</span>
                                        </li>
                                         <li class="list-group-item d-flex flex-column border-0" >
                                            <span className="d-block ">Pipelines</span>
                                            <span className="d-block "  style={{color: "#17949d", fontWeight:"bold"}}>{formatCurrency(res?.estimated_value, true)}</span>
                                        </li>
                                         <li class="list-group-item d-flex flex-column border-0" >
                                            <span className="d-block ">Quotation</span>
                                            <span className="d-block "  style={{color: "#17949d", fontWeight:"bold"}}>{formatCurrency(res?.quotation, true)}</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        )
                    }) : <LoadedComponent />
                }
            </div>
        </>
    )
}

export default BrandDetails