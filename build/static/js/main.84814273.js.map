import React, { useEffect, useState } from "react";
import { connect, useDispatch } from "react-redux";
import { Link, Redirect, useLocation } from "react-router-dom";
import { logout } from "../../../redux/action/auth";
import Loaded from "../../Loaded/Loaded";
import "./Sidebar.scss";
import { useHistory } from "react-router-dom";
import { QueryClient } from "react-query";
const Sidebar = ({
  promo: { promoCategories },
  product: { brands },
  auth: { user },
}) => {
  const history = useHistory()
  const dispatch = useDispatch();
  //assigning location variable
  const location = useLocation();
  //destructuring pathname from location
  const { pathname } = location;
  //Javascript split method to get the name of the path in array
  const splitLocation = pathname.split("/");
  
  const [productBar, setProductBar] = useState(false);
  const [promoBar, setPromoBar] = useState(false);
  const [crmBar, setCrmBar] = useState(false);
  const [reportBar, setReportBar] = useState(false);
  const [approvalBar, setApprovalBar] = useState(false);
  const [childBar, setChildBar] = useState({
    reportDetail: false,
  });
  useEffect(() => {
    const expandedChildBar = [{name:"Quotation", href: "/dashboard/report-deals-detail/quotation"}, {name:"Settlement", href:"/dashboard/report-deals-detail/settlement"}, {name:"Deals", href:"/dashboard/report-deals-detail/deals"}, {name:"Partial",href:"/dashboard/report-deals-detail/partial"}, {name:"Down Payment", href:"/dashboard/report-deals-detail/down-payment"},{name:"Cancelled", href:"/dashboard/report-deals-detail/cancelled"}].some((d) => d.href === location.pathname)
    if(expandedChildBar){
      setReportBar(true)
      setChildBar((prev) => {
        return {
          ...prev,
          reportDetail:true
        }
      })
    }
    window.scrollTo(0, 0);
  }, [location]);
  const handleGoToSeeDetails = () => {
    history.push({
      pathname: `/dashboard/dashboard-see-detail/${user?.data?.id}/${user?.data?.as?.toLowerCase()}`,
      state: { filterDate: {start:"",
      end:""}, idCompany: "" },
    });
  };
  const handleLogOut = () => {
    localStorage.removeItem('data_user_log_new');
    localStorage.removeItem('ally-supports-cache');
    localStorage.removeItem('chakra-ui-color-mode');
    localStorage.removeItem('user_type_log');
    localStorage.removeItem('company_id');
    localStorage.removeItem('user_id_log');
    localStorage.removeItem('auth');
    localStorage.removeItem('user_type_leads_filter');
    localStorage.removeItem('channels_leads_filter');
    localStorage.removeItem('loading_pipelines');
    localStorage.removeItem("token");
    const queryClient = new QueryClient();
    queryClient.clear();
    history.push("/login")
    // setIsAuthentication(false);
    dispatch(logout());
    return <Redirect to="/login" />;
  };
  return promoCategories && brands && user ? (
    <nav
      id="sidebarMenu"
      className="col-md-3 col-lg-2 d-md-block bg-light sidebar"
    >
      <div className="position-sticky ">
        <div className="sidebar-logo">
          <img src="/Asset/MOVES LOGO-01 1.png" alt="Logo" />
        </div>
        <div className="sidebar-logo-mobile">
          <img src="/Asset/fav.png" alt="Logo" />
        </div>
        {/* Dashboard */}
        <ul className="nav flex-column">
          <li className="nav-item ">
            <Link
              className={`nav-link ${
                splitLocation[1] === "dashboard" &&
                splitLocation[2] === undefined
                  ? "active"
                  : ""
              }`}
              aria-current="page"
              to="/dashboard"
            >
              <img src="/Asset/Sidebar/Dashboard.png" alt="dashboard" />
              <span className="menu-title">Dashboard</span>
            </Link>
          </li>

          {/* Approval */}

          {user?.data?.as?.toLowerCase() !== "sales" &&(<li className="dropdown">
            <div
              className={`nav-link d-flex justify-content-between`}
              aria-current="page"
              onClick={() => setApprovalBar(!approvalBar)}
            >
              <div>
                <img src="/Asset/Sidebar/time.png" alt="dashboard" />
                <span className="menu-title">Approval</span>
              </div>
              {approvalBar ? (
                <img
                  src="/Asset/Sidebar/arrow up.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              ) : (
                <img
                  src="/Asset/Sidebar/arrow down.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              )}
              
            </div>
            <div className={`sub-menu ${approvalBar ? "dd-active" : ""}`}>
              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "WAITING_APPROVAL" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/approval/WAITING_APPROVAL"
                >
                  <p>Need My Approval</p>
                </Link>
              </div>
              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "APPROVED" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/approval/APPROVED"
                >
                  <p>Approved</p>
                </Link>
              </div>
              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "REJECTED" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/approval/REJECTED"
                >
                  <p>Rejected</p>
                </Link>
              </div>
              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "ALL" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/approval/ALL"
                >
                  <p>All</p>
                </Link>
              </div>
            </div>
          </li>)}

          {/* Report */}

          <li className="dropdown">
            <div
              className={`nav-link d-flex justify-content-between`}
              aria-current="page"
              to={"/dashboard/customers"}
              onClick={() => setReportBar(!reportBar)}
            >
              <div>
                <img src="/Asset/Sidebar/Report.png" alt="dashboard" />
                <span className="menu-title">Report</span>
              </div>
              {reportBar ? (
                <img
                  src="/Asset/Sidebar/arrow up.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              ) : (
                <img
                  src="/Asset/Sidebar/arrow down.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              )}
            </div>
            <div className={`sub-menu ${reportBar ? "dd-active" : ""}`}>
              {user?.data?.as?.toLowerCase() !== "sales" && <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "report" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/new-report-leads"
                  // to="/dashboard/report"
                >
                  <p>Leads</p>
                </Link>
              </div>}
              {/* <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "report_brands" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/report_brands"
                >
                  <p>Brands</p>
                </Link>
              </div> */}
              <div className="nav-item dropdown" onClick={() => setChildBar((prev) => ({...prev,reportDetail: !prev.reportDetail}))}>
                <div className="nav-link" style={{display: "grid", gridTemplateColumns:"5rem 1rem", gap:"52px"}} >
                  <p style={{width:"100%"}}>Report Deals Detail</p>
                  {childBar.reportDetail ? (
                    <img
                      src="/Asset/Sidebar/arrow up.png"
                      alt="arrow"
                      className="arrow-bar"
                    />
                  ) : (
                    <img
                      src="/Asset/Sidebar/arrow down.png"
                      alt="arrow"
                      className="arrow-bar"
                    />
                  )}
                </div>
              </div>
              <ul className="nav flex-column">
                {
                  [{name:"Quotation", href: "/dashboard/report-deals-detail/quotation"}, {name:"Settlement", href:"/dashboard/report-deals-detail/settlement"}, {name:"Deals", href:"/dashboard/report-deals-detail/deals"}, {name:"Partial",href:"/dashboard/report-deals-detail/partial"}, {name:"Down Payment", href:"/dashboard/report-deals-detail/down-payment"},{name:"Cancelled", href:"/dashboard/report-deals-detail/cancelled"}].map((d,i) => (
                    <React.Fragment key={i}>
                      <li className="dropdown" style={{marginLeft:"10px"}}>
                        <div className={`sub-menu ${childBar.reportDetail ? "dd-active" : ""}`}>
                        <div className="nav-item">
                          <a
                            className={`nav-link ${
                             d.href === location.pathname && "active"
                            }`}
                            aria-current="page"
                            href={d.href}
                            
                          >
                            <p>{d.name}</p>
                          </a>
                          </div>
                        </div>
                      </li>
                    </React.Fragment>
                  ))
                }
              </ul>
              <div className="nav-item dropdown" onClick={handleGoToSeeDetails}>
                <div className="nav-link"> <p style={{width:"100%"}}>Dashboard Detail</p></div>
                </div>
            </div>
          </li>

          {/* Product */}
          <li className="dropdown">
            <Link
              className={`nav-link d-flex justify-content-between `}
              aria-current="page"
              to="/dashboard/product"
              onClick={() => setProductBar(!productBar)}
            >
              <div>
                <img src="/Asset/Sidebar/Produk.png" alt="dashboard" />
                <span className="menu-title">Produk</span>
              </div>
              {productBar ? (
                <img
                  src="/Asset/Sidebar/arrow up.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              ) : (
                <img
                  src="/Asset/Sidebar/arrow down.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              )}
            </Link>
            <div className={`sub-menu ${productBar ? "dd-active" : ""}`}>
              {brands?.data?.map((brand) => {
                return (
                  <div className="nav-item" key={brand.id}>
                    <Link
                      className={`nav-link ${
                        splitLocation[1] === "produk1" && "active"
                      }`}
                      aria-current="page"
                      to={`/dashboard/product/product_by_brand/${brand.name}/${brand.id}`}
                    >
                      <p>{brand.name}</p>
                    </Link>
                  </div>
                );
              })}
            </div>
          </li>
          {/* Promo */}
          <li className="dropdown">
            <Link
              className={`nav-link d-flex justify-content-between`}
              aria-current="page"
              to={"/dashboard/promo-categories"}
              onClick={() => setPromoBar(!promoBar)}
            >
              <div>
                <img src="/Asset/Sidebar/Promo.png" alt="promo" />
                <span className="menu-title">Promo</span>
              </div>
              {promoBar ? (
                <img
                  src="/Asset/Sidebar/arrow up.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              ) : (
                <img
                  src="/Asset/Sidebar/arrow down.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              )}
            </Link>
            <div className={`sub-menu ${promoBar ? "dd-active" : ""}`}>
              {promoCategories?.data?.map((category) => {
                return (
                  <div className="nav-item" key={category.id}>
                    <Link
                      className={`nav-link ${
                        splitLocation[2] === category.name && "active"
                      }`}
                      aria-current="page"
                      to={`/dashboard/promo-categories/${category.id}/${category.name?.replace(/[^\w\s]/g, "")?.split(" ")?.join("-")}`}
                    >
                      <p>{category.name}</p>
                    </Link>
                  </div>
                );
              })}
            </div>
          </li>
          {/* CRM */}
          <li className="dropdown">
            <div
              className={`nav-link d-flex justify-content-between`}
              aria-current="page"
              to={"/dashboard/customers"}
              onClick={() => setCrmBar(!crmBar)}
            >
              <div>
                <img src="/Asset/Sidebar/Customer.png" alt="dashboard" />
                <span className="menu-title">CRM</span>
              </div>
              {crmBar ? (
                <img
                  src="/Asset/Sidebar/arrow up.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              ) : (
                <img
                  src="/Asset/Sidebar/arrow down.png"
                  alt="arrow"
                  className="arrow-bar"
                />
              )}
            </div>
            <div className={`sub-menu ${crmBar ? "dd-active" : ""}`}>
              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "unhandled" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/customers/unhandled"
                >
                  <p>Unhandled</p>
                </Link>
              </div>
              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "leads" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/customers/leads"
                >
                  <p>Leads</p>
                </Link>
              </div>

              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "prospect" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/customers/prospect"
                >
                  <p>Prospect</p>
                </Link>
              </div>
              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "deal" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/customers/deal"
                >
                  <p>Deal</p>
                </Link>
              </div>
              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "drop" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/customers/drop"
                >
                  <p>Drop</p>
                </Link>
              </div>
              <div className="nav-item">
                <Link
                  className={`nav-link ${
                    splitLocation[3] === "designer" && "active"
                  }`}
                  aria-current="page"
                  to="/dashboard/customers/designer"
                >
                  <p>Designer</p>
                </Link>
              </div>
            </div>
          </li>

          {/* Logout */}
          <li className="nav-item">
            <div
              className={`nav-link ${
                splitLocation[1] === "sign-out" && "active"
              }`}
              aria-current="page"
              style={{ cursor: "pointer" }}
              onClick={handleLogOut}
            >
              <img src="/Asset/Sidebar/Group 1765.png" alt="dashboard" />
              <span className="menu-title">Sign Out</span>
            </div>
          </li>
        </ul>
      </div>
    </nav>
  ) : (
    <div
      style={{
        position: "fixed",
        top: "0",
        right: "0",
        zIndex: "120",
        width: "100vw",
      }}
    >
      <Loaded />
    </div>
  );
};
const mapStateToProps = (state) => ({
  auth: state.auth,
  product: state.product,
  promo: state.promo,
});

export default connect(mapStateToProps)(Sidebar);
