import React, { useEffect, useState } from "react";
import { formatCurrency } from "../../../../api/format";
import "./EditDiscount.css";
import CurrencyInput from "react-currency-input-field";
import Button from "../../../Button/Button";
import axios from "axios";
import { mainUrl } from "../../../../api/api";

const EditDiscount = (props) => {
  const {
    order,
    setAdditionalDiscount,
    additionalDiscount,
    preview,
    user,
    priceDiscount,
    setEditDiscountPopup,
    editDiscountPopup,
    refresh,
    setRefresh,
  } = props;

  const [toggle, setToggle] = useState(false);
  //   console.log(order);
  const [note, setNote] = useState("");

  const sendApproval = async () => {
    // setIsLoading(true);
    if (note.length > 5) {
      try {
        const res = await axios.post(
          `${mainUrl}/orders/request-approval/${order.id}`,
          {
            approval_note: note,
            additional_discount: priceDiscount,
            discount_take_over_by: user.data.id,
          },
          {
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${localStorage.token}`,
            },
          }
        );

        console.log(res.data);
        setEditDiscountPopup(false);
        setRefresh(!refresh);
      } catch (error) {
        console.error(error);
        //   setIsLoading(false);
      }
    }
  };

  return (
    order && (
      <div className="edit_discount">
        <h3>Edit Approval</h3>
        <p>
          Disc Limit:{" "}
          {formatCurrency(
            (order.discount_approval_limit_percentage / 100) *
              order.original_price
          )}
        </p>
        <hr />
        <div>
          <p>Edit Discount</p>
          <div>
            <input
              type="checkbox"
              id="discount_percentage"
              name="discount_percentage"
              onChange={() => {
                setToggle(!toggle);
                setAdditionalDiscount(null);
              }}
            />
            <label htmlFor="discount_percentage">Discount in Percent</label>
          </div>
          {!toggle ? (
            <CurrencyInput
              value={additionalDiscount}
              placeholder={formatCurrency(order.additional_discount)}
              onValueChange={(value) => setAdditionalDiscount(value)}
              prefix="Rp."
              delimiter="."
              separator=","
              precision={0}
              style={{
                borderWidth: 0.6,
                borderColor: "#c4c4c4",
                padding: 12,
                borderRadius: 6,
                // marginBottom: heightPercentageToDP(2),
              }}
            />
          ) : (
            <CurrencyInput
              value={(additionalDiscount / order.original_price) * 100}
              placeholder={"%"}
              onValueChange={(value) =>
                setAdditionalDiscount((value / 100) * order.original_price)
              }
              suffix="%"
              maxLength={3}
              precision={0}
              style={{
                borderWidth: 0.6,
                borderColor: "#c4c4c4",
                padding: 12,
                borderRadius: 6,
                // marginBottom: heightPercentageToDP(2),
              }}
            />
          )}
          <div className="mt-3">
            <label htmlFor="notes">
              Notes<span style={{ color: "red" }}>*</span>
            </label>
            <textarea
              name="notes"
              className={`form-control ${note.length < 5 && "is-invalid"}`}
              id="notes"
              value={note}
              onChange={(e) => setNote(e.target.value)}
            />
          </div>
          <p>Total Price : {formatCurrency(preview)}</p>
          <div onClick={(e) => sendApproval(e)}>
            <Button
              title={"Send Request Approval"}
              btnStyle={"primary-btn"}
              btnWidth={"100%"}
            />
          </div>
        </div>
      </div>
    )
  );
};

export default EditDiscount;
