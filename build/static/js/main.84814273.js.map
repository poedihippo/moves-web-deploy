import React, { useEffect, useState } from "react";
import { useDispatch } from "react-redux";
import { Link } from "react-router-dom";
import { loadFirstMonth, loadSecondMonth } from "../../../redux/action/target";
import { formatCurrency } from "../../../api/format";
const ReportComparasion = ({isData}) => {
    let dateStartCom = new Date(isData?.compare_date?.start);
    let dateEndCom = new Date(isData?.compare_date?.end);
    let dateStartOri = new Date(isData?.original_date?.start);
    let dateEndOri = new Date(isData?.original_date.end);
    
    const isMonths = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    const dataReportTable = [
    
        {
          compare: isData.deals.compare,
          value: isData.deals.value,
          name: "Deals"
        },
       {
          compare: isData.new_leads.compare,
          value: isData.new_leads.value,
          name: "New Leads"
        },
        {
          compare: isData.quotation.compare,
          value: isData.quotation.value,
          name: "Quotation"
        },
        {
          compare: isData.estimation.compare,
          value: isData.estimation.value,
          name:"Pipelines"
        },
         {
          compare: isData.follow_up.total_activities.compare,
          value: isData.follow_up.total_activities.value,
          name:"Follow Up"
        }
      
    ]
    return(
        <>
            <div className='report'>
                <div className='date-value-and-compare d-flex justify-content-around' style={{marginBottom:"30px"}}>
                    <span style={{padding:"0.5rem 1rem", width: "9rem", textAlign:"start"}}>Date:</span>
                    <div className='wrap-date'style={{justifyContent:"space-around",display:"flex", flexDirection: "column", gap: "10px", textAlign: "end", padding:"0.5rem 1rem", width:"13rem"}}>
                        <span>Start: {dateStartCom.getDate()} {isMonths[parseInt(dateStartCom.getMonth())]} {dateStartCom.getFullYear()}</span>
                        <span>End: {dateEndCom.getDate()} {isMonths[parseInt(dateEndCom.getMonth())]} {dateEndCom.getFullYear()}</span>
                    </div>
                    <div className='wrap-date'style={{justifyContent:"space-around",display:"flex", flexDirection: "column", gap: "10px",textAlign:"end", padding:"0.5rem 1rem",width:"13rem"}}>
                        <span>Start: {dateStartOri.getDate()} {isMonths[parseInt(dateStartOri.getMonth())]} {dateStartOri.getFullYear()}</span>
                        <span>End: {dateEndOri.getDate()} {isMonths[parseInt(dateEndOri.getMonth())]} {dateEndOri.getFullYear()}</span>
                    </div>
                </div>

                <table className="data " style={{ margin: "10px 0" }}>
                    <thead>
                        <tr>
                        <th style={{textAlign:"start"}}>Name</th>
                        <th style={{textAlign:"end"}}>Compare</th>
                        <th style={{textAlign:"end"}}>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        {dataReportTable.map((data, i) => {
                        return (
                            
                            <tr key={i}>
                            <td style={{position:"relative", textAlign:"start"}}>{data.name} {parseInt(data.value) < parseInt(data.compare) ? (<span style={{width:"0", height:"0", borderLeft: "5px solid transparent", borderRight: "5px solid transparent", marginLeft: "10px", display: "inline-block", position: "absolute", top:"50%", transform: "translateY(-50%)", right:"0", borderTop:"10px solid red" }}></span>) : (<span style={{width:"0", height:"0", borderLeft: "5px solid transparent", borderRight: "5px solid transparent", marginLeft: "10px", display: "inline-block", position: "absolute", top:"50%", transform: "translateY(-50%)", right:"0", borderBottom:"10px solid green" }}></span>)}</td>
                            <td style={{textAlign:"end"}}>{data.name !== "Follow Up" && data.name !== "New Leads" ? "Rp" : ""} {formatCurrency(data.compare, true).replace(/([A-Za-z])\w+/g, '')}</td>
                            <td style={{textAlign: "end"}}>{data.name !== "Follow Up" && data.name !== "New Leads" ? "Rp" : ""} {formatCurrency(data.value, true).replace(/([A-Za-z])\w+/g, '')}</td>
                            </tr>
                        );
                        })}
                    </tbody>
                </table>
            </div>
        </>
    )
}

export default ReportComparasion