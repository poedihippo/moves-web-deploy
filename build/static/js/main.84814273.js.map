import axios from "axios";
import React, { useEffect, useMemo, useState } from "react";
import { connect } from "react-redux";
import { Link, Redirect } from "react-router-dom";
import { mainUrl } from "../../../api/api";
import { isValidate } from "../../../lib/Validate";
import Button from "../../Button/Button";
import useLeadsList from "../../../api/useLeadsList";
const CartPopup = ({ auth: { user, loading } }) => {
  const [searchState, setSearchState] = useState({
    id: user?.data?.data ?? "",
    search:""
  })
  const [leadsProspect, setLeadsProspect] = useState(null);
  const [leadId, setLeadId] = useState(null);
  const [leadValidate, setLeadValidate] = useState(false);
  const [redirectCheckout, setRedirectCheckout] = useState(false);
  const {data:dataLeads, isLoading:loadingLeads, error:errorLeads} = useLeadsList({searchState, type:"LEADS"});
  const {data:dataProspect, isLoading:loadingProspect, error:errorProspect} = useLeadsList({searchState, type:"PROSPECT"});
  useEffect(() => {
    if(dataLeads && dataProspect){
      setLeadsProspect(dataLeads?.data?.concat(dataProspect?.data ?? []) ?? []);
    }
  }, [dataLeads, dataProspect])
  // console.log(user.data.id);
  

  const handleSubmit = (e) => {
    e.preventDefault();
    isValidate(leadId) ? setLeadValidate(true) : setRedirectCheckout(true);
  };

  useEffect(() => {
    leadsProspect && leadsProspect?.length !== 0
      ? setLeadId(leadsProspect[0].id)
      : setLeadId(null);
  }, [leadsProspect]);
  if(errorLeads || errorProspect){
    return (<div className="cart-popup" id="cart-popup">
  
            <div>
              <h2 style={{textAlign:"center", color:"red"}}>Terjadi kesalahan pada server...</h2>
            </div>
          </div>)
  }
  return (
    leadsProspect && (
      <div className="cart-popup" id="cart-popup">
        {redirectCheckout && (
          <Redirect to={`/dashboard/product/checkout/${leadId}`} />
        )}
        <div>
          <h2>Please select a lead/prospect</h2>
          <form className=" mt-4 mb-4" onSubmit={handleSubmit}>
            <div className="mt-3">
              {isValidate(leadId) && (
                <div className="alert alert-danger">
                  Please select a valid customer.
                </div>
              )}
              <div className="d-flex">
                <input
                  type="text"
                  className="form-control"
                  name="customer"
                  style={{ height: "41px", width: "40%", fontSize: "11px" }}
                  placeholder="Search by name,email,phone"
                  onChange={(e) => {
                    setSearchState((prev) => {
                      return {
                        ...prev,
                        search:e.target.value
                      }
                    })
                  }}
                  autoComplete="off"
                />
                <select
                  className={`form-select ${
                    isValidate(leadId) && "is-invalid"
                  }`}
                  name="color"
                  // value={filterCompany}
                  onChange={(e) => setLeadId(e.target.value)}
                >
                  {leadsProspect.length !== 0 ? (
                    leadsProspect.map((data) => {
                      return (
                        <option value={data.id} key={data.id}>
                          {`${data.customer.first_name} ${data.customer.last_name} (${data.customer.email}) (${data.customer.phone}) (${data.status})`}
                        </option>
                      );
                    })
                  ) : (
                    <option value="">Data No Found</option>
                  )}
                </select>
              </div>
            </div>
            <div className="mt-3">
              <Button
                title={"Add"}
                icon={""}
                btnWidth={"100%"}
                btnStyle="primary-btn"
              />
            </div>
          </form>
        </div>
      </div>
    )
  );
};

const mapStateToProps = (state) => ({
  auth: state.auth,
});

export default connect(mapStateToProps)(CartPopup);
