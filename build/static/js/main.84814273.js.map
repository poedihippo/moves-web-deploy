import React, { useEffect } from "react";
import { connect, useDispatch } from "react-redux";
import { Switch } from "react-router-dom";
import Sidebar from "../../../components/Navbar components/Sidebar/Sidebar";
import PrivateRoute from "../../../components/PrivateRoute/PrivateRoute";
import { loadUser } from "../../../redux/action/auth";
import { loadCategories } from "../../../redux/action/customer";
import { loadBrands, loadCarts } from "../../../redux/action/product";
import { loadPromoCategories } from "../../../redux/action/promo";
import CustomerDetail from "../customers/CustomerDetail";
import CustomersScreen from "../customers/CustomersScreen";
import CustomerUnhandled from "../customers/CustomerUnhandled";
import Comparationv2 from "../dashboardPage/Comparationv2";
import Dashboard from "../dashboardPage/Dashboard";
import InteriorDesign from "../dashboardPage/InteriorDesign";
import InteriorDesignDetail from "../dashboardPage/InteriorDesignDetail";
import NewLeadsSeeDetails from "../dashboardPage/invoiceSeeDetails/NewLeadsSeeDetails";
import Notification from "../dashboardPage/Notification";
import SalesRevenue from "../dashboardPage/SalesRevenue";
import SalesRevenueBum from "../dashboardPage/SalesRevenueBum";
import SalesRevenueSales from "../dashboardPage/SalesRevenueSales";
import SalesRevenueStoreLeader from "../dashboardPage/SalesRevenueStoreLeader";
import Settlement from "../dashboardPage/Settlement";
import InvoiceDetails from "../dashboardPage/invoiceSeeDetails/InvoiceDetail";
import TopChannel from "../dashboardPage/TopChannel";
import TopPerformanceBum from "../dashboardPage/TopPerformanceBum";
import TopSales from "../dashboardPage/TopSales";
import Cart from "../product/Cart";
import NewCart from "../product/NewCart";
import Checkout from "../product/Checkout";
import Payment from "../product/Payment/Payment";
import PaymentByType from "../product/Payment/PaymentByType";
import InvoiceSeeDetails from "../dashboardPage/invoiceSeeDetails/InvoiceSeeDetails";
import InteriorDesignSeeDetails from "../dashboardPage/invoiceSeeDetails/interiorSeeDetails";
import FollowUpSeeDetails from "../dashboardPage/invoiceSeeDetails/followUpSeeDetails";
import PipelinesSeeDetails from "../dashboardPage/invoiceSeeDetails/pipelinesSeeDetails";
import DetailInterior from "../dashboardPage/invoiceSeeDetails/reportDetail/detailInterior";
import Product from "../product/Product";
import ProductByBrand from "../product/ProductByBrand";
import ProductDetail from "../product/ProductDetail";
import ProductOption from "../product/ProductOption";
import SelectChannel from "../product/SelectChannel";
import Stock from "../product/Stock";
import StockDetail from "../product/StockDetail";
import Promo from "../promo/Promo";
import PromoCategories from "../promo/PromoCategories";
import PromoCategory from "../promo/PromoCategory";
import PromoDetail from "../promo/PromoDetail";
import DetailChannel from "../product/DetailChannel";
import "./DashboardRouter.css";
import PaymentCategories from "../product/Payment/PaymentCategories";
import ConfirmPayment from "../product/Payment/ConfirmPayment";
import Activities from "../dashboardPage/Activities";
import ActivitiesFollowUpDetail from "../dashboardPage/invoiceSeeDetails/Activities";
import BrandCategory from "../dashboardPage/BrandCategory";
import CustomerDesigner from "../customers/CustomerDesigner";
import { loadChannels, loadDesigners } from "../../../redux/action/target";
import LeadDesigner from "../customers/LeadDesigner";
import LeadDesignerActivities from "../customers/LeadDesignerActivities";
import PipeLine from "../../../components/Report/PipeLine";
import SeeDetails from "../dashboardPage/SeeDetails";
import ReportLeadDetail from "../../../components/Report/ReportLeadDetail";
import ReportLeadStatus from "../../../components/Report/ReportLeadStatus";
import ReportBrandsDetail from "../../../components/Report/ReportBrandsDetail";
import ReportBrands from "../../../components/Report/ReportBrands";
import ReportLeads from "../../../components/Report/ReportLeads";
import SalesEstimation from "../../../components/Report/SalesEstimation";
import DropReport from "../../../components/Report/DropReport";
import ActivityCount from "../dashboardPage/ActivityCount";
import Approval from "../approval/Approval";
import DashboardSeeDetail from "../dashboardPage/DashboardSeeDetail";
import NewReportLeadStatus from "../../../components/Report/NewReportLeadStatus";
import DashboardReport from "../dashboardPage/DashboardReport";
import ReportLeadSingle from "../../../components/Report/ReportLeadsSingle";
import { useLocation } from "react-router-dom";
import ListStocks from "../product/ListStocks";
import NotaMasuk from "../product/Payment/Nota";
// New Report Leads
import ReportLeadsStatus from "../../../components/Report/container/ReportLeadsStatus";
import ReportLeadsStatusHot from "../../../components/Report/container/ReportLeadsStatusHot";
import ReportLeadsDetailHot from "../../../components/Report/container/ReportLeadsDetailHot";
import ReportLeadsDetailDeals from "../../../components/Report/container/ReportLeadsDetailDeals";
import ReportLeadsDrop from "../../../components/Report/container/ReportLeadsDrop";
import FppRequest from "../../../components/ActivityDetail/FppRequest";
const DashboardRouter = ({ auth: { user, loading } }) => {
  const dispatch = useDispatch();
  const location = useLocation();
  useEffect(() => {
    if(location.pathname !== "/dashboard/report"){
      localStorage.removeItem("date_leads_start")
      localStorage.removeItem("date_leads_end")
    }
    dispatch(loadUser());
    dispatch(loadCategories());
    dispatch(loadPromoCategories());
    dispatch(loadBrands());
    dispatch(loadCarts());
    dispatch(loadDesigners());
    dispatch(loadChannels());
    // user && localStorage.setItem("data_user_log_new", JSON.stringify(user?.data));
  }, [dispatch]);

  return (
    <div id="dashboard">
      <Sidebar />
      <main className="dashboard-layout">
        <Switch>
          <PrivateRoute path={"/dashboard"} exact component={Dashboard} />
          {/* {user !== null && user !== undefined && <PrivateRoute path={"/testing-dashboard"} exact component={DashboardReport} />} */}
          <PrivateRoute
            path={"/dashboard/product/product_detail/stocks/:idProductUnit"}
            component={ListStocks}
          />
          <PrivateRoute
            path={"/dashboard/product/bukti-payment/:id"}
            component={NotaMasuk}
          />
          <PrivateRoute path={"/dashboard/new-report-leads"} exact component={ReportLeadSingle} />
          {/* Report Leads New Router */}
            {/* <PrivateRoute
              path={
                "/dashboard/report/detail/:user_type?/:user_id?/:detail_type?/:start?/:end?"
              }
              exact
              component={ReportLeads}
            /> */}

            <PrivateRoute
              path={
                "/dashboard/report-detail-hot/:user_type?/:user_id?/:detail_type?/:start?/:end?"
              }
              exact
              component={ReportLeadsDetailHot}
            />
            <PrivateRoute
              path={
                "/dashboard/report-detail-deals/:user_type?/:user_id?/:detail_type?/:start?/:end?"
              }
              exact
              component={ReportLeadsDetailDeals}
            />

            {/* <PrivateRoute
              path={"/dashboard/sales_estimation/:user_type?/:user_id?/:start?/:end?"}
              component={SalesEstimation}
            /> */}

            <PrivateRoute
              path={
                "/dashboard/report/status/:user_type?/:user_id?/:detail_type?/:start?/:end?"
              }
              exact
              component={ReportLeadsStatus}
            />

            <PrivateRoute
              path={
                "/dashboard/reports/status/:user_type?/:user_id?/:detail_type?/:start?/:end?"
              }
              exact
              component={ReportLeadsStatusHot}
            />

            <PrivateRoute
              path={"/dashboard/report-drop/:user_type?/:user_id?/:start?/:end?"}
              exact
              component={ReportLeadsDrop}
            />

          {/* End Report Leads New Router */}
          <PrivateRoute 
            path={"/dashboard/sales_revenue_bum/:company_id/:month"}
            component={SalesRevenueBum}
          />
          <PrivateRoute
            path={"/dashboard/report-deals-detail/:invoice_type/:id_user?/:start_date?/:end_date?"}
            exact
            component={InvoiceDetails}
          />
           <PrivateRoute
            path={"/dashboard/follow-up-activities/:status/:id?/:start?/:end?/:company_id?/:channels_id?"}
            component={ActivitiesFollowUpDetail}
          />

          <PrivateRoute
            path={"/dashboard/dashboard-see-detail/:id/:userType/:startDate?/:endDate?"}
            exact
            component={DashboardSeeDetail}
          />
          <PrivateRoute
            path={"/dashboard/see-details"}
            exact
            component={SeeDetails}
          />
          <PrivateRoute
            path={"/dashboard/see-details/invoice"}
            exact
            component={InvoiceSeeDetails}
          />
          
          <PrivateRoute
            path={"/dashboard/see-details/interior-design"}
            exact
            component={InteriorDesignSeeDetails}
          />
          <PrivateRoute
            path={"/dashboard/see-details/interior-design/detail"}
            exact
            component={DetailInterior}
          />
          <PrivateRoute
            path={"/dashboard/see-details/leads"}
            exact
            component={NewLeadsSeeDetails}
          />
          <PrivateRoute
            path={"/dashboard/see-details/follow-up/:status"}
            exact
            component={FollowUpSeeDetails}
          />
          <PrivateRoute
            path={"/dashboard/see-details/pipelines"}
            exact
            component={PipelinesSeeDetails}
          />
          <PrivateRoute
            path={"/dashboard/product/stock/channel/:sku"}
            exact
            component={DetailChannel}
          />
          <PrivateRoute
            path={
              "/dashboard/sales_revenue_store_leader/:company_id/:user_id/:month"
            }
            component={SalesRevenueStoreLeader}
          />
          <PrivateRoute
            path={"/dashboard/sales_revenue_sales/:company_id/:user_id/:month"}
            component={SalesRevenueSales}
          />
          <PrivateRoute
            path={
              "/dashboard/sales_revenue/:user_id/:channel_id/:company_id/:month"
            }
            component={SalesRevenue}
          />
          <PrivateRoute
            path={"/dashboard/interior_design/:company_id/:month"}
            exact
            component={InteriorDesign}
          />
          <PrivateRoute
            path={
              "/dashboard/interior_design/:company_id/:month/:interiorDesignId"
            }
            component={InteriorDesignDetail}
          />

          <PrivateRoute path={"/dashboard/report"} exact component={PipeLine} />

          <PrivateRoute
            path={
              "/dashboard/report/detail/:user_type/:user_id/:detail_type/:start/:end"
            }
            exact
            component={ReportLeads}
          />

          <PrivateRoute
            path={
              "/dashboard/report/:user_type/:user_id/:detail_type/:start/:end"
            }
            exact
            component={ReportLeadDetail}
          />

          <PrivateRoute
            path={"/dashboard/sales_estimation/:user_type/:user_id/:start/:end"}
            component={SalesEstimation}
          />

          <PrivateRoute
            path={
              "/dashboard/report/:user_type/:user_id/:detail_type/:start/:end/status"
            }
            exact
            component={ReportLeadStatus}
          />
          <PrivateRoute
            path={
              "/dashboard/reports/:user_type/:user_id/:detail_type/:start/:end/status"
            }
            exact
            component={NewReportLeadStatus}
          />

          <PrivateRoute
            path={"/dashboard/drop/:user_type/:user_id/:start/:end"}
            exact
            component={DropReport}
          />

          <PrivateRoute
            path={"/dashboard/settlement/:company_id/:month"}
            component={Settlement}
          />
          <PrivateRoute
            path={"/dashboard/notification"}
            component={Notification}
          />
          <PrivateRoute
            path={"/dashboard/comparation"}
            component={Comparationv2}
          />

          <PrivateRoute
            path={"/dashboard/top-performance/:company_id/:month"}
            component={TopPerformanceBum}
          />

          <PrivateRoute
            path={"/dashboard/top-channel/:company_id/:month"}
            component={TopChannel}
          />

          <PrivateRoute
            path={"/dashboard/top-sales/:type/:company_id/:month/:id"}
            component={TopSales}
          />

          <PrivateRoute
            path={"/dashboard/activities/:status/:company_id/:month"}
            component={Activities}
          />

          <PrivateRoute
            path={"/dashboard/activity_count/:company_id/:month"}
            component={ActivityCount}
          />

          <PrivateRoute
            path={
              "/dashboard/brand_category/:brand_category_name/:brand_id/:company_id/:month"
            }
            component={BrandCategory}
          />

          <PrivateRoute
            path={"/dashboard/report_brands"}
            exact
            component={ReportBrands}
          />
          <PrivateRoute
            path={"/dashboard/report_brands/detail/:user_id/:start/:end"}
            component={ReportBrandsDetail}
          />
          <PrivateRoute
            path={"/dashboard/approval/:approval_type"}
            exact
            component={Approval}
          />

          {/* Produk */}
          <PrivateRoute path={"/dashboard/product"} exact component={Product} />
          <PrivateRoute
            path={"/dashboard/product/stocks"}
            exact
            component={SelectChannel}
          />
          <PrivateRoute
            path={"/dashboard/product/stocks/:channel_id"}
            component={Stock}
          />
          <PrivateRoute
            path={
              "/dashboard/product/stocks/stock_detail/:channel_id/:company_id/:product_unit_id"
            }
            component={StockDetail}
          />
          <PrivateRoute
            path={"/dashboard/product/product_detail/:model_id"}
            component={ProductDetail}
          />
          <PrivateRoute
            path={"/dashboard/product/product_option/:model_id"}
            component={ProductOption}
          />

          <PrivateRoute
            path={"/dashboard/product/product_by_brand/:brand_name/:brand_id"}
            component={ProductByBrand}
          />
          <PrivateRoute path={"/dashboard/add/cart"} component={NewCart} />
          <PrivateRoute path={"/dashboard/product/cart"} component={Cart} />
          <PrivateRoute
            path={"/dashboard/product/checkout/:lead_id"}
            component={Checkout}
          />
          <PrivateRoute
            path={"/dashboard/payment/:orderId"}
            exact
            component={Payment}
          />

          <PrivateRoute
            path={"/dashboard/payment/:orderId/payment_categories"}
            exact
            component={PaymentCategories}
          />

          <PrivateRoute
            path={
              "/dashboard/payment/:orderId/:payment_category/:payment_category_id"
            }
            exact
            component={PaymentByType}
          />

          <PrivateRoute
            path={"/dashboard/confirm_payment/:orderId/:payment_type_id"}
            exact
            component={ConfirmPayment}
          />

          {/* Promo */}
          <PrivateRoute
            path={"/dashboard/promo-categories"}
            exact
            component={PromoCategories}
          />
          <PrivateRoute
            path={"/dashboard/promo-categories/:category_id/:category_name"}
            exact
            component={Promo}
          />
          <PrivateRoute
            path={"/dashboard/category-promo/:category_name/:category_id"}
            exact
            component={PromoCategory}
          />
          <PrivateRoute
            path={"/dashboard/promo/promo_detail/:promo_id"}
            component={PromoDetail}
          />

          {/* Customer */}
          <PrivateRoute
            path={"/dashboard/customers/unhandled"}
            exact
            component={CustomerUnhandled}
          />
          <PrivateRoute
            path={"/dashboard/customers/designer"}
            exact
            component={CustomerDesigner}
          />
          <PrivateRoute
            path={"/dashboard/customers/designer/:designer_id/leads"}
            exact
            component={LeadDesigner}
          />

          <PrivateRoute
            path={
              "/dashboard/customers/designer/:designer_id/leads/:acitivity_id"
            }
            component={LeadDesignerActivities}
          />
          <PrivateRoute
            path={"/dashboard/customers/:customers_type"}
            exact
            component={CustomersScreen}
          />
          <PrivateRoute
            path={"/dashboard/customers/customer_detail/:leads_id/:customer_id"}
            component={CustomerDetail}
          />
          <PrivateRoute 
            path={"/dashboard/customers/customers_detail/fpp_request"}
            component={FppRequest}
          />
        </Switch>
      </main>
    </div>
  );
};

const mapStateToProps = (state) => ({
  auth: state.auth,
  target: state.target,
  customer: state.customer,
});

export default connect(mapStateToProps)(DashboardRouter);
