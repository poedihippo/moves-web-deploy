import React, {useEffect, useState} from 'react';
import LoadedComponent from '../../Loaded/LoadedComponent';
import Button from '../../Button/Button';
import { getLocationsData } from '../../../pages/dahsboards/product/apiProduct';
const ProductDetails = ({isSku}) => {
    const [statusStock, setStatusStock] = useState(0);
    const [isLoading, setIsLoading] = useState(true);
    const [locationsData, setLocationsData] = useState([]);
    const [messageError, setMessageError] = useState("");
    const [filterStock, setFilterStock] = useState([])
    useEffect(() => {

        const getDataStocks = async () => {
            const res = await getLocationsData(isSku);
            if(res.success){
                setLocationsData(res?.data?.stocks);
                setFilterStock(res?.data?.stocks);
                setIsLoading(false);
            }
            if(!res.success){
                setMessageError(res.message);
                setIsLoading(false)
            }
        }
        getDataStocks()
    }, [])
    const handleClickEvent = (status) => {
        setStatusStock(status);
        let resFilter;
        const cpyIsData = [...locationsData];
        resFilter = cpyIsData
        if(status !== 0){
            const filterStock = cpyIsData.filter((a,b) => {
                if(status === 1 && a.stock > 0){
                    return a
                }

                if(status === 2 && a.stock === 0){
                    return a
                }
            })
            resFilter = filterStock
        }
        setFilterStock(resFilter)
    }
    return(
        <div className='brand-details' style={{marginTop: "25px"}}>
          

               
                   <div class="card h-max" style={{margin: "20px 0", height:"max-content"}}>
                                <div class="card-header" style={{backgroundColor: "white", position:"relative"}}>
                                    <h4 className='text-start' style={{fontSize: "18px", fontWeight:"bold"}}>SKU: {isSku}</h4>
                                    <div style={{position: "absolute", top:"0", right:0, backgroundColor: "#17949d", padding: "5px 7px", fontSize: "12px", color:"white", borderRadius: "0 0 0 10px"}}>Detail</div>
                                    <div style={{display:"flex", justifyContent:"space-around", marginTop:"30px"}}>
                                        <Button onClick={(e) => handleClickEvent(0)}icon="" title="Semua"  btnStyle={"primary-btn"} />
                                        <Button onClick={(e) => handleClickEvent(1)}icon="" title="Memiliki Stock"  btnStyle={"primary-btn"} />
                                        <Button onClick={(e) => handleClickEvent(2)}icon="" title="Stock Kosong"  btnStyle={"primary-btn"} />
                                    </div>
                                </div>
                                
                               {!isLoading && locationsData.length !== 0 ? filterStock.map(resData => {

                               return ( <div class="card-body">
                                    <ul class="list-group list-group-horizontal border-0 justify-content-between" style={{fontSize:"13px"}}>
                                        <li class="list-group-item d-flex flex-column border-0" >
                                            <span className="d-block ">Name Warehouse</span>
                                            <span className="d-block " style={{color: "#17949d", fontWeight:"bold", width:"150px"}}>{resData.name}</span>
                                        </li>
                                         <li class="list-group-item d-flex flex-column border-0" >
                                            <span className="d-block ">Orlan Id</span>
                                            <span className="d-block "  style={{color: "#17949d", fontWeight:"bold"}}>{resData.orlan_id}</span>
                                        </li>
                                         <li class="list-group-item d-flex flex-column border-0" >
                                            <span className="d-block ">Total Stock</span>
                                            <span className="d-block "  style={{color: "#17949d", fontWeight:"bold"}}>{resData.stock}</span>
                                        </li>
                                    </ul>
                                </div>)
                                })
                                : messageError !== "" ? <h2>Terjadi Kesalahan Pada Server</h2> : <LoadedComponent />
                            }
                            </div>
             
                      
            </div>
    )
}

export default ProductDetails