import axios from "axios";
import moment from "moment";
import React, { useEffect, useState } from "react";
import { mainUrl } from "../../../../api/api";
import { isValidate } from "../../../../lib/Validate";
import Button from "../../../Button/Button";
import CurrencyInput from "react-currency-input-field";
import "../PopUpStyles.scss";
import { connect } from "react-redux";

const EditActivityPopup = ({
  target: { designers },
  auth: { user },
  lead_id,
  refresh,
  setRefresh,
  setPopup,
  activity,
}) => {
  // const [brandActive, setBrandActive] = useState(false);
  const [brands, setBrands] = useState(null);

  const [followUpMethod, setFollowUpMethod] = useState("");
  const [status, setStatus] = useState("");
  const [brand_ids, setBrand_ids] = useState([]);
  const [estimatedValue, setEstimatedValue] = useState(0);
  const [feedback, setFeedback] = useState("");
  const [reminder, setReminder] = useState();
  const [reminderNote, setReminderNote] = useState("");
  const [interior_design_id, setInterior_design_id] = useState(null);

  // validation
  const [followUpValidation, setFollowUpValidation] = useState(false);
  const [statusValidation, setStatusValidation] = useState(false);
  const [feedbackValidation, setFeedbackValidation] = useState(false);
  const [reminderNoteValidation, setReminderNoteValidation] = useState(false);
  const [valueEstimatedValidation, setValueEstimatedValidation] =
    useState(false);

  // ----------------------------------

  const [notification, setNotification] = useState(false);

  const [formBrands, setFormBrands] = useState([
    { product_brand_id: "", estimated_value: "" },
  ]);

  let handleChangeEstimated_value = (i, value) => {
    let newFormBrands = [...formBrands];
    newFormBrands[i]["estimated_value"] = parseInt(value);
    setFormBrands(newFormBrands);
  };

  let handleChangeBrand_id = (i, e) => {
    let newFormBrands = [...formBrands];
    let newBrand_ids = [...brand_ids];
    if (e.target.value) {
      newFormBrands[i]["product_brand_id"] = parseInt(e.target.value);
      newBrand_ids[i] = parseInt(e.target.value);
      setFormBrands(newFormBrands);
      setBrand_ids(newBrand_ids);
    }
  };

  let addFormBrands = () => {
    setFormBrands([
      ...formBrands,
      { product_brand_id: "", estimated_value: "" },
    ]);
  };

  let removeFormBrands = (i) => {
    let newFormBrands = [...formBrands];
    let newBrand_ids = [...brand_ids];
    newFormBrands.splice(i, 1);
    newBrand_ids.splice(i, 1);
    setFormBrands(newFormBrands);
    setBrand_ids(newBrand_ids);
  };

  

  // ----------------------------------

  useEffect(() => {
    const config = {
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${localStorage.token}`,
        Accept: "application/json, text-plain, */*",
      },
    };
    const getBrands = async () => {
      try {
        const res = await axios.get(`${mainUrl}/brands`, config);
        
        setBrands(res?.data?.data ?? []);
      } catch (error) {
        console.error(error);
      }
    };

    getBrands();
  }, []);

  const addActivity = async (body) => {
    const actId = localStorage.getItem("act_id") ?? ""
    const config = {
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${localStorage.token}`,
      },
    };


    try {
      const res = await axios.put(`${mainUrl}/activities/${actId ?? ""}`, body, config);
      alert("Activity updated")
      setFollowUpMethod("");
      setStatus("");
      setBrand_ids([]);
      setFeedback("");
      setFormBrands([{ product_brand_id: "", estimated_value: "" }]);

      if (body.status === "HOT") {
        setNotification(true);
      } else {
        setPopup(false);
      }

      setRefresh(!refresh);

      setFollowUpMethod("");
      setStatus("");
      setBrand_ids([]);
      setFeedback("");
      setReminder("");
      setReminderNote("");
      setInterior_design_id(null);
    } catch (error) {
      console.error(error);
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    let date = new Date(reminder);
    const d = new Date();
    let followUpDateTime = moment(d).format("YYYY-MM-DDTHH:mm:ss.SSS");
    let reminderDate = moment(date).format("YYYY-MM-DDTHH:mm:ss.SSS");
   

    isValidate(followUpMethod)
      ? setFollowUpValidation(true)
      : setFollowUpValidation(false);
    isValidate(status) ? setStatusValidation(true) : setStatusValidation(false);
    feedback.length < 19
      ? setFeedbackValidation(true)
      : setFeedbackValidation(false);
    isValidate(reminderNote)
      ? setReminderNoteValidation(true)
      : setReminderNoteValidation(false);

    if (
      !isValidate(followUpMethod) &&
      !isValidate(status) &&
      !isValidate(brand_ids) &&
      !isValidate(formBrands) &&
      // !isValidate(formBrands.estimated_value) > 5000000 &&
      feedback.length >= 20
    ) {
      let data = {};
      if (reminder) {
        data = {
          follow_up_method: followUpMethod,
          follow_up_datetime: followUpDateTime,
          status: status,
          feedback: feedback,
          lead_id: localStorage.getItem("lead_id"),
          reminder_datetime: reminderDate && reminderDate,
          reminder_note: reminderNote && reminderNote,
          brand_ids: brand_ids,
          estimations: formBrands,
          interior_design_id: interior_design_id && interior_design_id,
        };
      } else {
        data = {
          follow_up_method: followUpMethod,
          follow_up_datetime: followUpDateTime,
          status: status,
          feedback: feedback,
          lead_id: localStorage.getItem("lead_id"),
          brand_ids: brand_ids,
          estimations: formBrands,
          interior_design_id: interior_design_id && interior_design_id,
        };
      }
      console.log(data, "check data yah")
      addActivity(data);
    }
  };

  return (
    user && (
      <div className="addactivity-popup-card" id="addactivity-popup-card">
        {notification ? (
          <h1 className="text-center">
            Harap untuk segera membuat dan mengirimkan quotation kepada Customer
          </h1>
        ) : (
          <form onSubmit={handleSubmit} method="POST">
            <div>
              <h3>Basic Information</h3>
              <hr />
              <div className=" mt-4 mb-4">
                <div className="mt-3">
                  <label>
                    Follow Up Method<span className="important">*</span>
                  </label>
                  <select
                    className={`form-select ${
                      followUpValidation &&
                      isValidate(followUpMethod) &&
                      "is-invalid"
                    }`}
                    name="followUpMethod"
                    id="followUpMethod"
                    style={{ height: "41px" }}
                    onChange={(e) => setFollowUpMethod(e.target.value)}
                  >
                    <option value="">Please select follow up method</option>
                    <option value={"PHONE"}>Phone</option>
                    <option value={"WHATSAPP"}>Whatsapp</option>
                    <option value={"MEETING"}>Meeting</option>
                    <option value={"OTHERS"}>Others</option>
                    <option value={"WALK_IN_CUSTOMER"}>Walk in Customer</option>
                  </select>
                  <div className="invalid-feedback">
                    Please select a valid value.
                  </div>
                </div>
                {/* <input type="hidden" name="_token" value={token}></input> */}
                <div className="mt-3">
                  <label>
                    Status<span className="important">*</span>
                  </label>
                  <select
                    className={`form-select ${
                      statusValidation &&
                      isValidate(followUpMethod) &&
                      "is-invalid"
                    }`}
                    name="status"
                    id="status"
                    style={{ height: "41px" }}
                    onChange={(e) => setStatus(e.target.value)}
                  >
                    <option value="">Please Select activity's Status</option>
                    <option value={"HOT"}>Hot</option>
                    <option value={"WARM"}>Warm</option>
                    <option value={"COLD"}>Cold</option>
                    <option value={"DEAL"}>Deal</option>
                  </select>
                  <div className="invalid-feedback">
                    Please select a valid status.
                  </div>
                </div>
                <div className="mt-3">
                  <label>
                    Brand List<span className="important">*</span>
                  </label>
                  <div
                    style={{
                      border: "0.5px solid #ced4da",
                      fontSize: "13px",
                      padding: "10px",
                      borderRadius: "0.25rem",
                    }}
                  >
                    {/* <div onClick={() => setBrandActive(!brandActive)}>
                  Click to select brand(s)
                </div> */}

                    <div className="mt-1" style={{ display: "block" }}>
                      {/* {brands &&
                    brands.map((brand) => {
                      return (
                        <div key={brand.id}>
                          <input
                            className="form-check-input me-2"
                            type="checkbox"
                            value={brand.id}
                            id="brand1"
                            onChange={(e) =>
                              setBrand_ids([
                                ...brand_ids,
                                parseInt(e.target.value),
                              ])
                            }
                          />
                          <label className="form-check-label" htmlFor="brand1">
                            {brand.name}
                          </label>
                        </div>
                      );
                    })} */}
                      {formBrands.map((element, idx) => {
                        return (
                          <div key={idx} className="mb-2">
                            <div className="row">
                              <div className="col-5">
                                {idx === 0 && (
                                  <label>
                                    Brands<span className="important">*</span>
                                  </label>
                                )}

                                <select
                                  className="form-select"
                                  name="brand"
                                  id="brand"
                                  style={{ height: "41px" }}
                                  onChange={(e) => handleChangeBrand_id(idx, e)}
                                >
                                  <option value="">Please Select Brands</option>
                                  {brands &&
                                    brands.map((brand) => {
                                      return (
                                        <option value={brand.id} key={brand.id}>
                                          {brand.name}
                                        </option>
                                      );
                                    })}
                                </select>
                              </div>
                              <div className="col-5">
                                {idx === 0 && <label>Estimated Value</label>}
                                <CurrencyInput
                                  id="estimated_value"
                                  name="estimated_value"
                                  className={`form-control ${
                                    formBrands[idx].estimated_value < 5000000 &&
                                    user?.data?.company_id === 1 &&
                                    "is-invalid"
                                  }`}
                                  placeholder="0"
                                  defaultValue={0}
                                  decimalsLimit={2}
                                  prefix="Rp"
                                  onValueChange={(value) =>
                                    handleChangeEstimated_value(idx, value)
                                  }
                                />
                                {formBrands[idx].estimated_value < 5000000 &&
                                  user?.data?.company_id === 1 && (
                                    <div className="invalid-feedback">
                                      Estimated value must be above Rp.5.000.000
                                    </div>
                                  )}
                              </div>
                              <div className="col-2">
                                <button
                                  type="button"
                                  style={{
                                    padding: "8px 16px",
                                    height: "auto",
                                    marginTop: idx === 0 ? "20px" : "0",
                                  }}
                                  className="btn btn-danger"
                                  onClick={() => removeFormBrands(idx)}
                                >
                                  Remove
                                </button>
                              </div>
                            </div>
                          </div>
                        );
                      })}
                      <div className="button-section mt-2">
                        <button
                          style={{ padding: "8px 16px" }}
                          className="button add btn btn-outline-primary"
                          type="button"
                          onClick={() => addFormBrands()}
                        >
                          + Add Brand
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
                {/* <div className="mt-3">
              <label>Estimated Value*</label>
              <input
                type="number"
                id="estimatedValue"
                name="estimatedValue"
                className="form-control"
                placeholder="Input feedback (optional)"
                value={estimatedValue}
                onChange={(e) =>
                  setEstimatedValue(
                    e.target.value ? parseInt(e.target.value) : ""
                  )
                }
                style={{ height: "41px" }}
              />
            </div> */}
                <div className="mt-3">
                  <label>Interior Design</label>
                  <select
                    className="form-select"
                    name="interio-design"
                    onChange={(e) =>
                      setInterior_design_id(parseInt(e.target.value))
                    }
                  >
                    <option value={""}>Select Interior Design</option>
                    {designers &&
                      designers.data.map((data) => {
                        return (
                          <option key={data.id} value={data.id}>
                            {data.name}
                          </option>
                        );
                      })}
                  </select>
                </div>

                <div className="mt-3">
                  <label>
                    Feedback<span className="important">*</span>
                  </label>
                  <textarea
                    type="text"
                    id="name"
                    name="name"
                    className={`form-control ${
                      feedbackValidation && feedback.length < 20 && "is-invalid"
                    }`}
                    placeholder="Input feedback (optional)"
                    value={feedback}
                    onChange={(e) => setFeedback(e.target.value)}
                    style={{ height: "100px" }}
                  />
                  <div className="invalid-feedback">
                    Please insert 20 or more character.
                  </div>
                </div>
                <div className="mt-3">
                  <label>Set Reminder</label>
                  <input
                    type="datetime-local"
                    id="reminder"
                    name="reminder"
                    className="form-control"
                    placeholder="Start Month"
                    onChange={(e) => setReminder(e.target.value)}
                    style={{ height: "41px" }}
                  />
                </div>
                {reminder && (
                  <div className="mt-3">
                    <label>
                      Note<span className="important">*</span>
                    </label>
                    <textarea
                      type="text"
                      id="reminderNote"
                      name="reminderNote"
                      className={`form-control ${
                        reminderNoteValidation &&
                        isValidate(reminderNote) &&
                        reminder &&
                        "is-invalid"
                      }`}
                      placeholder="Note Reminder"
                      value={reminderNote}
                      onChange={(e) => setReminderNote(e.target.value)}
                      style={{ height: "100px" }}
                    />
                    <div className="invalid-feedback">Please insert note.</div>
                  </div>
                )}
              </div>
              <div>
                <Button
                  title={"Add"}
                  icon={""}
                  btnWidth={"100%"}
                  btnStyle={"primary-btn"}
                />
              </div>
            </div>
          </form>
        )}
      </div>
    )
  );
};

const mapStateToProps = (state) => ({
  target: state.target,
  auth: state.auth,
});

export default connect(mapStateToProps)(EditActivityPopup);
