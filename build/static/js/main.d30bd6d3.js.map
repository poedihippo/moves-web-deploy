import axios from "axios";
import React from "react";
import { mainUrl } from "../../../../api/api";
import Button from "../../../Button/Button";

const UpdateLead = (props) => {
  const { customer, isType } = props;
  const handleUpgrade = async () => {
    const data = {
      id: customer.id,
      label: customer.label,
      customer_id: customer.customer.id,
      type: isType,
      lead_category_id: customer?.lead_category?.id ?? null
    };

    try {
      const res = await axios.put(`${mainUrl}/leads/${customer.id}`, data, {
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${localStorage.token}`,
        },
      });
      if(res){
        isType === "DROP" && window.location.assign("/dashboard/customers/drop")
      }
    } catch (error) {
      console.error(error);
    }
  };

  return (
    <div className="comparation-popup-card d-flex text-center justify-content-center align-items-center">
      <div>
        <h3>Are you sure to upgrade Leads?</h3>

        <div onClick={() => handleUpgrade()}>
          <Button title={"Submit"} icon={""} btnStyle="primary-btn" />
        </div>
      </div>
    </div>
  );
};

export default UpdateLead;
