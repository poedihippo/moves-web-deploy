import axios from "axios";
import React, { useState } from "react";
import moment from "moment";
import { mainUrl } from "../../../api/api";
import Button from "../../Button/Button";
import "./PopUpStyles.scss";
import provinceList from "../../../api/provinces";
import cityList from "../../../api/cities";
import countryList from "../../../api/countries";
import kecamatanList from "../../../api/data_kecamatan.json";
import provinsiList from "../../../api/data_provinsi.json";
import kabkotList from "../../../api/data_kabkot.json";
import SelectorKecamatan from "../../Selectors/SelectorKecamatan";
import SelectorKabkot from "../../Selectors/SelectorKabkot";
import SelectorKelurahan from "../../Selectors/SelectorKelurahan";
import SuccessPopup from "../../SuccessPopUp/PopupSuccess";
import SelectorProvinsi from "../../Selectors/SelectorProvinsi";
const UpdateCustomerPopup = (props) => {
  const { customer, address, refreshCustomer, setRefreshCustomer } = props;
  const [isSuccess, setIsSuccess] = useState(false);
  const [kelurahan, setKelurahan] = useState(address?.district ?? "");
  const [kecamatan, setKecamatan] = useState(address?.sub_district ?? "")
  const [addEmail, setAddEmail] = useState(customer?.customer?.email ? true : false)
  const [picName, setPicName] = useState(customer?.customer?.pic_name ?? "");
  const [title, setTitle] = useState(
    customer.customer.title ? customer.customer.title : ""
  );
  const [firstName, setFirstName] = useState(
    customer.customer.first_name ? customer.customer.first_name : ""
  );
  const [lastName, setLastName] = useState(
    customer.customer.last_name ? customer.customer.last_name : ""
  );
  let date = customer.customer.date_of_birth
    ? moment(customer.customer.date_of_birth).format("YYYY-MM-DD")
    : "";
  const [DoB, setDoB] = useState(
    date
      ? date
      : customer.customer.date_of_birth
      ? customer.customer.date_of_birth
      : ""
  );

  const [description, setDescription] = useState(
    customer.customer.description ? customer.customer.description : ""
  );
  const [customerPhone, setCustomerPhone] = useState(
    customer.customer.phone ? customer.customer.phone : ""
  );
  const [email, setEmail] = useState(
    customer.customer.email ? customer.customer.email : ""
  );
  const [priority, setPriority] = useState(
    customer.status ? customer.status : ""
  );

  // / Addresses
  const [address1, setAddress1] = useState(
    address.address_line_1 ? address.address_line_1 : ""
  );
  const [address2, setAddress2] = useState(
    address.address_line_2 ? address.address_line_2 : ""
  );
  const [address3, setAddress3] = useState(
    address.address_line_3 ? address.address_line_3 : ""
  );
  const [province, setProvince] = useState(
    address.province ? address.province : ""
  );
  const [city, setCity] = useState(address.city ? address.city : "");
  const [country, setCountry] = useState(
    address.country ? address.country : ""
  );
  const [postCode, setPostCode] = useState(
    address.postcode ? address.postcode : ""
  );
  const [addressType, setAddressType] = useState(
    address.type ? address.type : ""
  );
  const [addressPhone, setAddressPhone] = useState(
    address.phone ? address.phone : ""
  );

  const updateCustomer = async (body) => {
    const config = {
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${localStorage.token}`,
      },
    };

    try {
      const res = await axios.put(
        `${mainUrl}/customers/${customer.customer.id}`,
        body,
        config
      );
      setRefreshCustomer(!refreshCustomer);
    } catch (error) {
      console.error(error);
    }
  };

  const addAddress = async (addressData) => {
    const config = {
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${localStorage.token}`,
      },
    };

    try {
      const res = await axios.post(
        `${mainUrl}/customers/addresses`,
        addressData,
        config
      );
      setIsSuccess(true)
    } catch (error) {
      console.error(error);
    }
  };

  const updateAddress = async (addressData) => {
    const config = {
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${localStorage.token}`,
      },
    };

    try {
      const res = await axios.put(
        `${mainUrl}/addresses/${address.id}`,
        addressData,
        config
      );
      setIsSuccess(true)
    } catch (error) {
      console.error(error?.response, "check error yah");
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    const body = {
      first_name: firstName,
      last_name: lastName,
      date_of_birth: DoB,
      description: description,
      title: title,
      email: email,
      phone: customerPhone,
      message: "",
    };

    const addressData = {
      address_line_1: address1,
      address_line_2: address2,
      address_line_3: address3,
      pic_name: title === "CV" || title === "PT" ? picName : "",
      district:kelurahan ?? "",
      sub_district:kecamatan ?? "",
      city: city,
      country: country,
      province: typeof province === "object" ? province.name : province,
      type: addressType,
      phone: addressPhone,
      customer_id: customer.customer.id,
      email: addEmail ? email : null,
    };


    updateCustomer(body);

    if (customer.customer.default_address_id === null) {
      addAddress(addressData);
    } else {
      updateAddress(addressData);
    }

  };

  return customer ? (
    <div className="newcustomer-popup-card">
      {isSuccess && <SuccessPopup message={"Data has been successfully updated!"} onClose={() => {
        setIsSuccess(false)
      }}/>}
      <form onSubmit={(e) => handleSubmit(e)}>
        <h3>Basic Information</h3>
        <hr />
        <div className=" mt-4 mb-4">
          <div className="mt-3">
            <label>
              Title<span>*</span>
            </label>
            <select
              className="form-select"
              name="title"
              id="title"
              style={{ height: "41px" }}
              onChange={(e) => setTitle(e.target.value)}
              defaultValue={title}
            >
              <option value="">Select Title</option>
              <option value={"MR"}>Mr.</option>
              <option value={"MS"}>Ms.</option>
              <option value={"MRS"}>Mrs.</option>
              <option value={"CV"}>Cv.</option>
              <option value={"PT"}>Pt.</option>
            </select>
          </div>
          <div className="mt-3 d-grid" style={{gridTemplateColumns:"1fr 1fr", gap:"10px"}}>
              <div className="mt-3">
                <label>
                  Name<span className="important">*</span>
                </label>
                <div className="">
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    className={`form-control `}
                    placeholder="First Name"
                    value={firstName}
                    onChange={(e) => setFirstName(e.target.value)}
                    style={{ height: "41px" }}
                  />
                  
                </div>
              </div>
              <div className="mt-3">
              <label>
                  Last Name<span className="important">*</span>
                </label>
              <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  className={`form-control`}
                  placeholder="Last Name"
                  value={lastName}
                  onChange={(e) => setLastName(e.target.value)}
                  style={{ height: "41px" }}
                />
              </div>
            </div>
          {/* <div className="mt-3">
            <label>
              Name<span>*</span>
            </label>
            <div className="d-flex">
              <input
                type="text"
                id="name"
                name="name"
                className="form-control"
                placeholder="First name"
                value={firstName}
                onChange={(e) => setFirstName(e.target.value)}
                style={{ height: "41px" }}
              />
              <input
                type="text"
                id="name"
                name="name"
                className="form-control"
                placeholder="Input name here"
                value={lastName}
                onChange={(e) => setLastName(e.target.value)}
                style={{ height: "41px" }}
              />
            </div>
          </div> */}
          <div className="mt-3">
            <label>
              Date of Birth<span>*</span>
            </label>
            <input
              type="date"
              id="DoB"
              name="DoB"
              className="form-control"
              placeholder="Start Month"
              value={DoB}
              onChange={(e) => setDoB(e.target.value)}
              style={{ height: "41px" }}
            />
          </div>
          <div className="mt-3">
            <label>
              Description<span>*</span>
            </label>
            <input
              type="text"
              id="description"
              name="description"
              className="form-control"
              placeholder="Input description here"
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              style={{ height: "41px" }}
            />
          </div>
          {(title === "CV" || title === "PT") && <div className="mt-3">
              <label>
                PIC Name<span className="important">*</span>
              </label>
              <input
                type="text"
                id="pic-name"
                name="phone-number"
                className={`form-control`}
                placeholder="Input PIC name here"
                value={picName}
                onChange={(e) => setPicName(e.target.value)}
                style={{ height: "41px" }}
              />
             
            </div>}
          <div className="mt-3">
            <label>
              Phone Number<span>*</span>
            </label>
            <input
              type="text"
              id="phone-number"
              name="phone-number"
              className="form-control"
              placeholder="Input phone number here"
              value={customerPhone}
              onChange={(e) => setCustomerPhone(e.target.value)}
              style={{ height: "41px" }}
              disabled={"true"}
            />
          </div>
          <div className="mt-3">
              <div>

                <input id="is-add-email" type="checkbox"  checked={addEmail} onChange={(e) => setAddEmail((prev) => !prev)}/>
                <label htmlFor="is-add-email">Want to add email?</label>
              </div>
              <label>
                Email<span className="">*</span>
              </label>
              <input
              disabled={addEmail ? false : true}
                type="email"
                id="email"
                name="email"
                className={`form-control`}
                placeholder="Input email here"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                style={{ height: "41px" }}
              />
              
            </div>
          {/* <div className="mt-3">
            <label>
              Email<span>*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              className="form-control"
              placeholder="Input email here"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              style={{ height: "41px" }}
            />
          </div> */}
          <div className="mt-3">
            <label>
              Priority<span>*</span>
            </label>
            <select
              className="form-select"
              name="status"
              style={{ height: "41px" }}
              defaultValue={priority}
              onChange={(e) => setPriority(e.target.value)}
            >
              <option value="">Select Status</option>
              <option value={"GREEN"}>Green</option>
              <option value={"YELLOW"}>Yellow</option>
              <option value={"RED"}>Red</option>
              <option value={"EXPIRED"}>Expired</option>
              <option value={"SALES"}>Sales</option>
              <option value={"OTHER SALES"}>Other Sales</option>
            </select>
          </div>
        </div>
        <h3>Address Information</h3>
        <hr />
        <div className=" mt-4 mb-4">
          <div className="mt-3">
            <label>
              Address Line 1<span>*</span>
            </label>
            <input
              type="text"
              id="address"
              name="address"
              className="form-control"
              placeholder="Input address here"
              style={{ height: "41px" }}
              value={address1}
              onChange={(e) => setAddress1(e.target.value)}
            />
          </div>
          <div className="mt-3">
            <label>Address Line 2</label>
            <input
              type="text"
              id="address"
              name="address"
              className="form-control"
              placeholder="Input address here"
              style={{ height: "41px" }}
              value={address2}
              onChange={(e) => setAddress2(e.target.value)}
            />
          </div>
          <div className="mt-3">
            <label>Address Line 3</label>
            <input
              type="text"
              id="address"
              name="address"
              className="form-control"
              placeholder="Input address here"
              style={{ height: "41px" }}
              value={address3}
              onChange={(e) => setAddress3(e.target.value)}
            />
          </div>
          <div className="mt-3">
              <label>Province</label>
              <SelectorProvinsi onChange={((e) => {
                setProvince(e.value)
              })} values={province} isMulti={false}/>
              
            </div>
            <div className="mt-3">
              <label>City</label>
              <SelectorKabkot onChange={((e) => {
                setCity(e.value)
              })} values={city} isMulti={false} filterCity={province == "" ? null : provinsiList?.filter((isProv) => isProv.provinsi?.toUpperCase() == province?.toUpperCase())[0]?.id}/>
              
            </div>
            <div className="mt-3">
              <label>Kecamatan</label>
              <SelectorKecamatan onChange={(e) => {
                setKecamatan(e?.value ?? "");
              }} values={kecamatan} isMulti={false} filterCity={city == "" ? null : kabkotList?.filter((isCty) => isCty.kabupaten_kota?.toUpperCase() == city?.toUpperCase())[0]?.id}/>
            </div>
            <div className="mt-3">
            <label>Kelurahan</label>
              <SelectorKelurahan  onChange={(e) => {
                setKelurahan(e?.value ?? "");
              }} values={kelurahan} isMulti={false} filterKec={kecamatan === "" ? null : kecamatanList?.filter((data) => data.kecamatan?.toUpperCase() == kecamatan?.toUpperCase())[0]?.id}/>
            </div>
          {/* <div className="mt-3">
            <label>
              Province<span>*</span>
            </label>
            <select
              className="form-select"
              id="province"
              name="province"
              style={{ height: "41px" }}
              onChange={(e) => {
                setProvince(JSON.parse(e.target.value));
              }}
            >
              <option value={"{ id: null, name: address.province }"}>
                {address.province ? address.province : "Select Province"}
              </option>
              {provinceList.map((province) => {
                return (
                  <option
                    value={JSON.stringify({
                      id: province.id,
                      name: province.name,
                    })}
                    key={province.id}
                  >
                    {province.name}
                  </option>
                );
              })}
            </select>
          </div> */}
          {/* <div className="mt-3">
            <label>
              City<span>*</span>
            </label>
            <select
              className="form-select"
              id="city"
              name="city"
              style={{ height: "41px" }}
              onChange={(e) => setCity(e.target.value)}
            >
              <option value={address.city}>
                {address.city ? address.city : "Select City"}
              </option>
              {cityList
                .filter((city) =>
                  province ? city.provinceId === province.id : ""
                )
                .map((city) => {
                  return (
                    <option value={city.name} key={city.id}>
                      {city.name}
                    </option>
                  );
                })}
            </select>
          </div> */}
          <div className="mt-3">
            <label>
              Country<span>*</span>
            </label>
            <select
              className="form-select"
              id="country"
              name="country"
              style={{ height: "41px" }}
              value={country}
              onChange={(e) => setCountry(e.target.value)}
            >
              <option value={address.country}>
                {address.country ? address.country : "Select Country"}
              </option>
              {countryList.map((country, i) => {
                return (
                  <option value={country} key={i}>
                    {country}
                  </option>
                );
              })}
            </select>
          </div>
          {/* <div className="mt-3">
            <label>
              Post Code<span>*</span>
            </label>
            <input
              type="number"
              id="zip-code"
              name="zip-code"
              className="form-control"
              placeholder="Input Zip Code"
              value={postCode}
              onChange={(e) => setPostCode(e.target.value)}
              style={{ height: "41px" }}
            />
          </div> */}
          <div className="mt-3">
            <label>
              Address Type<span>*</span>
            </label>
            <select
              className="form-select"
              id="addressType"
              name="addressType"
              style={{ height: "41px" }}
              onChange={(e) => setAddressType(e.target.value)}
            >
              <option value="">Select Address Type</option>
              <option value={"ADDRESS"}>Address</option>
              <option value={"DELIVERY"}>Delivery</option>
              <option value={"BILLING"}>Billing</option>
            </select>
          </div>
        </div>
        <div>
          <Button
            title={"Submit"}
            icon={""}
            btnWidth={"100%"}
            btnStyle={"primary-btn"}
          />
        </div>
      </form>
    </div>
  ) : (
    <h1>Loading . . .</h1>
  );
};

export default UpdateCustomerPopup;
