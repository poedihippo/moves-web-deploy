import React from "react";
import { Link } from "react-router-dom";
import { pickColor } from "../../api/pickColor";
import IsBar from "../../pages/dahsboards/dashboardPage/IsBar";
import CurrencyFormat from 'react-currency-format';
import { NumericFormat } from 'react-number-format';
import { formatCurrency } from "../../api/format";
const NewReportCard = ({title, compare = null, target = null, value = null, handleClickToSeeDetail, idCard, datasSet, isDataUser}) => {
  
  return (
    <div className="report-card col-md-3" style={{paddingLeft:"0"}}>
        <div className="report-card-wrapper p-3" onClick={handleClickToSeeDetail}id={idCard} style={{height: "8rem", cursor:isDataUser?.as?.toUpperCase() === "SALES" ? "pointer" : "auto"}}>
          <h5 className='mb-2' data-status-type={datasSet}>
            {title}
          </h5>
          <div className="">
            <h4 className='m-0' style={{color: title?.toUpperCase() === "DEALS" ? "#17949D" : "#179D63", position: "relative"}}>
              {title?.toUpperCase() === "DEALS" ? formatCurrency(value, true): value}{value < compare ? (<span style={{width:"0", height:"0", borderLeft: "5px solid transparent", borderRight: "5px solid transparent", marginLeft: "10px", display: "inline-block", position: "absolute", top:"50%", transform: "translateY(-50%)", right:"0", borderTop:"10px solid red" }}></span>) : (<span style={{width:"0", height:"0", borderLeft: "5px solid transparent", borderRight: "5px solid transparent", marginLeft: "10px", display: "inline-block", position: "absolute", top:"50%", transform: "translateY(-50%)", right:"0", borderBottom:"10px solid green" }}></span>)}
            </h4>
          </div>
          <IsBar target={target} value={value} colorPercent={title?.toUpperCase() === "DEALS" ? "#17949D" : "#179D63"}/>
          <p>Target: {target?.toLocaleString("id-ID")}</p>
        </div>
    </div>
  );
};

export default NewReportCard;
