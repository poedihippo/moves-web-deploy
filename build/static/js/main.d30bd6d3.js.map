import axios from "axios";
import React, { useState } from "react";
import { mainUrl } from "../../../api/api";
import cityList from "../../../api/cities";
import countryList from "../../../api/countries";
import provinceList from "../../../api/provinces";
import kelurahanList from "../../../api/data_kelurahan.json";
import kecamatanList from "../../../api/data_kecamatan.json";
import provinsiList from "../../../api/data_provinsi.json";
import kabkotList from "../../../api/data_kabkot.json";
import { isValidate } from "../../../lib/Validate";
import Button from "../../Button/Button";
import AddLeadForm from "../../forms/AddLeadForm";
import SelectorKecamatan from "../../Selectors/SelectorKecamatan";
import SelectorKabkot from "../../Selectors/SelectorKabkot";
import SelectorKelurahan from "../../Selectors/SelectorKelurahan";
import SelectorProvinsi from "../../Selectors/SelectorProvinsi";
import "./PopUpStyles.scss";
const NewCustomerPopup = (props, { setUpdate, update }) => {
  // alert("ha")
  const [customer, setCustomer] = useState();
  const [isNewCustomer, setIsNewCustomer] = useState(false);
  const [addEmail, setAddEmail] = useState(true)
  const [errorText, setErrorText] = useState(null);
  const [picName, setPicName] = useState(null);
  // Basic Information
  const [first_name, setFirst_name] = useState("");
  const [last_name, setLast_name] = useState("");
  const [date_of_birth, setDate_of_birth] = useState("");
  // const [description, setDescription] = useState("");
  const [title, setTitle] = useState("");
  const [email, setEmail] = useState("");
  const [phone, setPhone] = useState("");
 
  // Addresses
  const [address_line_1, setAddress_line_1] = useState("");
  const [address_line_2, setAddress_line_2] = useState("");
  const [address_line_3, setAddress_line_3] = useState("");
  const [province, setProvince] = useState("");
  const [city, setCity] = useState("");
  const [country, setCountry] = useState("");
  const [type, setType] = useState("");
  const [kelurahan, setKelurahan] = useState("");
  const [kecamatan, setKecamatan] = useState("")
  // validation
  const [titleValidation, setTitleValidation] = useState(false);
  const [firstNameValidation, setFirstNameValidation] = useState(false);
  const [lastNameValidation, setLastNameValidation] = useState(false);
  const [emailValidation, setEmailValidation] = useState(false);
  const [phoneValidation, setPhoneValidation] = useState(false);
  const [picValidation, setPicValidation] = useState(false);
  const [isBillingAddress, setIsBillingAddress] = useState(true)
  const [address1Validation, setAddress1Validation] = useState(false);
  const [typeValidation, setTypeValidation] = useState(false);
  const [errorBackend, setErrorBackend] = useState(null)
  const handleSubmit = (e) => {
    e.preventDefault();
    // console.log("pahse 1")

    // validation
    // Basic information
    isValidate(title) ? setTitleValidation(true) : setTitleValidation(false);
    isValidate(last_name) ? setLastNameValidation(true) : setLastNameValidation(false);
    isValidate(first_name)
      ? setFirstNameValidation(true)
      : setFirstNameValidation(false);
      
    isValidate(email) ? setEmailValidation(true) : setEmailValidation(false);
    isValidate(phone) ? setPhoneValidation(true) : setPhoneValidation(false);
    isValidate(picName) ? setPicValidation(true) : setPicValidation(false)
    // Addresses

    isValidate(address_line_1)
      ? setAddress1Validation(true)
      : setAddress1Validation(false);
    isValidate(type) ? setTypeValidation(true) : setTypeValidation(false);
    
    if(address_line_1?.length < 5){
      
      return setAddress1Validation(true)
    }
    
    const config = {
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${localStorage.token}`,
        Accept: "application/json, text-plain, */*",
      },
    };
    
    const data = {
      first_name: first_name,
      last_name: last_name && last_name,
      date_of_birth: date_of_birth && date_of_birth,
      pic_name: title === "CV" || title === "PT" ? picName : "",
      district:kelurahan ?? "",
      sub_district:kecamatan ?? "",
      title: title,
      email: addEmail ? email : null,
      phone: phone.startsWith("8") && !phone.startsWith("08") ? "0" + phone : phone,
      address_line_1: address_line_1,
      address_line_2: address_line_2 && address_line_2,
      address_line_3: address_line_3 && address_line_3,
      city: city && city,
      country: country && country,
      province: province ,
      type: type,
    };
    
    const createCustomerAndAddress = async () => {
      try {
        
        const res = await axios.post(
          `${mainUrl}/customers/addresses`,
          data,
          config
        );
        setCustomer(res.data.data);
        setIsNewCustomer(true);
        setPicName("")
        setFirst_name("");
        setLast_name("");
        setDate_of_birth("");
        setTitle("");
        setEmail("");
        setAddress_line_1("");
        setAddress_line_2("");
        setAddress_line_3("");
        setProvince("");
        setCity("");
        setCountry("");
        setType("");
      } catch (error) {
        // console.log(error);
        // console.log(error.response.data?.errors);
        // if(error?.response && error?.response?.data && error?.response?.data?.errors){
          
        //   const errorObj = Object.values(error?.response?.data?.errors ?? {});
        //   console.log(errorObj, "check yah")
        //   setErrorBackend(errorObj)
        // }
        setErrorText(error?.response?.data ?? "error on the server");
      }
    };


    if(title == "CV" || title == "PT"){
      if(isValidate(picName)){
        return
      }
    }
    if (
      !isValidate(last_name) &&
      !isValidate(first_name) &&
      !isValidate(title) &&
      !isValidate(phone) &&
      !isValidate(address_line_1) &&
      !isValidate(type)
    ) {
      createCustomerAndAddress();
      // props.setPopup(false);
      window.scrollTo(0, 0);
    }
  };

  // const handleProvinceChange = (e) => {
  //   setProvince(provinceList.id === parseInt(provinceId) ? province.name : "");
  // };
  return (
    <div className="newcustomer-popup-card">
      {isNewCustomer ? (
        <AddLeadForm
          newCustomer={customer ? customer : ""}
          setPopup={props.setPopup}
          setUpdate={props.setUpdate}
          update={props.update}
          setIsNewCustomer={setIsNewCustomer}
          isNewCustomer={isNewCustomer}
          isBillingAddress={isBillingAddress}
        />
      ) : (
        <form onSubmit={(e) => handleSubmit(e)}>
          <h3>Basic Information</h3>
          <hr />
          <div className=" mt-4 mb-4">
            {errorText ? (
              <div
                className="alert alert-danger"
                role="alert"
              // onClick={() => setError("")}
              >
                {errorText
                  ? errorText?.errors
                    ? errorText?.errors?.email
                      ? errorText?.errors?.email[0]
                      : errorText?.errors?.phone[0]
                    : ""
                  : ""}
              </div>
            ) : (
              ""
            )}
            <div className="mt-3">
              <label>
                Title<span className="important">*</span>
              </label>
              <select
                className={`form-select ${titleValidation && isValidate(title) && "is-invalid"
                  } `}
                name="title"
                id="title"
                style={{ height: "41px" }}
                onChange={(e) => setTitle(e.target.value)}
              >
                <option value="">Select Title</option>
                <option value={"MR"}>Mr.</option>
                <option value={"MS"}>Ms.</option>
                <option value={"MRS"}>Mrs.</option>
                <option value={"PT"}>Pt.</option>
                <option value={"CV"}>Cv.</option>
              </select>
              {isValidate(title) && (
                <div className="invalid-feedback">
                  Please select a valid title.
                </div>
              )}
            </div>
            <div className="mt-3 d-grid" style={{gridTemplateColumns:"1fr 1fr", gap:"10px"}}>
              <div className="mt-3">
                <label>
                  Name<span className="important">*</span>
                </label>
                <div className="">
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    className={`form-control ${firstNameValidation &&
                      isValidate(first_name) &&
                      "is-invalid"
                      }`}
                    placeholder="First Name"
                    value={first_name}
                    onChange={(e) => setFirst_name(e.target.value)}
                    style={{ height: "41px" }}
                  />
                  
                </div>
              </div>
              <div className="mt-3">
              <label>
                  Last Name<span className="important">*</span>
                </label>
              <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  className={`form-control ${lastNameValidation &&
                    isValidate(last_name) &&
                    "is-invalid"
                    }`}
                  placeholder="Last Name"
                  value={last_name}
                  onChange={(e) => setLast_name(e.target.value)}
                  style={{ height: "41px" }}
                />
              </div>
            </div>

            <div className="mt-3">
              <label>Date of Birth</label>
              <input
                type="date"
                id="DoB"
                name="DoB"
                className={`form-control`}
                placeholder="Start Month"
                value={date_of_birth}
                onChange={(e) => setDate_of_birth(e.target.value)}
                style={{ height: "41px" }}
              />
            </div>
            {(title === "CV" || title === "PT") && <div className="mt-3">
              <label>
                PIC Name<span className="important">*</span>
              </label>
              <input
                type="text"
                id="pic-name"
                name="phone-number"
                className={`form-control ${picValidation && isValidate(picName) && "is-invalid"
                  }`}
                placeholder="Input PIC name here"
                value={picName}
                onChange={(e) => setPicName(e.target.value)}
                style={{ height: "41px" }}
              />
              {isValidate(picName) && (
                <div className="invalid-feedback">
                  Please input PIC Name.
                </div>
              )}
            </div>}
            <div className="mt-3">
              <label>
                Phone Number<span className="important">*</span>
              </label>
              <input
              inputmode="numeric" 
              pattern="[0-9]*"
                type="text"
                id="phone-number"
                name="phone-number"
                className={`form-control ${phoneValidation && isValidate(phone) && "is-invalid"
                  }`}
                placeholder="Input phone number here"
                value={phone}
                onChange={(e) => {
                  const alphabetUppercase = [...Array(26)].map((_, i) => String.fromCharCode(65 + i));
                  if(isNaN(Number(e.target.value))){
                    return
                  }
                  setPhone(e.target.value)
                }}
                style={{ height: "41px" }}
              />
              {isValidate(phone) && (
                <div className="invalid-feedback">
                  Please insert a valid Phone Number.
                </div>
              )}
            </div>
            <div className="mt-3">
              <div>

                <input id="is-add-email" type="checkbox" defaultChecked="true" checked={addEmail} onChange={(e) => setAddEmail((prev) => !prev)}/>
                <label htmlFor="is-add-email">Want to add email?</label>
              </div>
              <label>
                Email<span className="important">*</span>
              </label>
              <input
              disabled={addEmail ? false : true}
                type="email"
                id="email"
                name="email"
                className={`form-control`}
                placeholder="Input email here"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                style={{ height: "41px" }}
              />
              
            </div>
            {/* <div className="mt-3">
            <label>
              Priority<span>*</span>
            </label>
            <input
              type="text"
              id="priority"
              name="priority"
              className="form-control"
              placeholder="Select Priority"
              style={{ height: "41px" }}
            />
          </div> */}
          </div>
          <h3>Address Information</h3>
          <hr />
          <div className=" mt-4 mb-4">
            <div className="mt-3">
              <label>
                Address Line 1{" (The address line 1 must be at least 30 characters.)"}<span>*</span>
              </label>
              <input
                type="text"
                id="address"
                name="address"
                className={`form-control ${address1Validation &&
                  isValidate() &&
                  "is-invalid"
                  }`}
                placeholder="Input address here"
                style={{ height: "41px" }}
                value={address_line_1}
                onChange={(e) => setAddress_line_1(e.target.value)}
              />
              
              {isValidate(address_line_1) && (
                <div className="invalid-feedback">Address is empty.</div>
              )}
              {address_line_1?.length > 1 && address_line_1?.length < 30 && <div className="" style={{fontSize:"13px", color:"red"}}>address line 1 must be at least 30 characters.</div>}
            </div>
            <div className="mt-3">
              <label>Address Line 2</label>
              <input
                type="text"
                id="address"
                name="address"
                className="form-control"
                placeholder="Input address here"
                style={{ height: "41px" }}
                value={address_line_2}
                onChange={(e) => setAddress_line_2(e.target.value)}
              />
            </div>
            <div className="mt-3">
              <label>Address Line 3</label>
              <input
                type="text"
                id="address"
                name="address"
                className="form-control"
                placeholder="Input address here"
                style={{ height: "41px" }}
                value={address_line_3}
                onChange={(e) => setAddress_line_3(e.target.value)}
              />
            </div>
            <div className="mt-3">
              <label>Province</label>
              <SelectorProvinsi onChange={((e) => {
                setProvince(e.value)
              })} values={""} isMulti={false}/>
              
            </div>
            <div className="mt-3">
              <label>City</label>
              <SelectorKabkot onChange={((e) => {
                setCity(e.value)
              })} values={""} isMulti={false} filterCity={province == "" ? null : provinsiList?.filter((isProv) => isProv.provinsi?.toUpperCase() == province?.toUpperCase())[0]?.id}/>
              
            </div>
            <div className="mt-3">
              <label>Kecamatan</label>
              <SelectorKecamatan onChange={(e) => {
                setKecamatan(e?.value ?? "");
              }} values={""} isMulti={false} filterCity={city == "" ? null : kabkotList?.filter((isCty) => isCty.kabupaten_kota?.toUpperCase() == city?.toUpperCase())[0]?.id}/>
            </div>
            <div className="mt-3">
            <label>Kelurahan</label>
              <SelectorKelurahan  onChange={(e) => {
                setKelurahan(e?.value ?? "");
              }} values={""} isMulti={false} filterKec={kecamatan === "" ? null : kecamatanList?.filter((data) => data.kecamatan?.toUpperCase() == kecamatan?.toUpperCase())[0]?.id}/>
            </div>
            
            <div className="mt-3">
              <label>Country</label>
              <select
                className={`form-select`}
                id="country"
                name="country"
                style={{ height: "41px" }}
                onChange={(e) => setCountry(e.target.value)}
              >
                <option value="">Select Province</option>
                {countryList.map((country, i) => {
                  return (
                    <option value={country} key={i}>
                      {country}
                    </option>
                  );
                })}
              </select>
            </div>
            
            <div className="mt-3">
              <label>
                Address Type<span>*</span>
              </label>
              <select
                className={`form-select ${typeValidation && isValidate(type) && "is-invalid"
                  }`}
                id="addressType"
                name="addressType"
                style={{ height: "41px" }}
                onChange={(e) => setType(e.target.value)}
              >
                <option value="">Select Address Type</option>
                <option value={"ADDRESS"}>Address</option>
                <option value={"DELIVERY"}>Delivery</option>
                <option value={"BILLING"}>Billing</option>
              </select>
              {isValidate(type) && (
                <div className="invalid-feedback">
                  Please select a valid address type.
                </div>
              )}
            </div>
            <div className="mt-3 d-flex" style={{gap:"10px"}}>
            <input id="is-add-billing-address" type="checkbox" defaultChecked="true" checked={isBillingAddress} onChange={(e) => setIsBillingAddress((prev) => !prev)}/>
              <label htmlFor="is-add-billing-address">
                Is the billing addres the same as delivery address?
              </label>
              
            </div>
          </div>

          {/* Address two */}
         
          <div>
            <Button
              title={"Submit"}
              icon={""}
              btnWidth={"100%"}
              btnStyle={"primary-btn"}
            />
          </div>
        </form>
      )}
    </div>
  );
};

export default NewCustomerPopup;
