import axios from "axios";
import "./PopUpStyles.scss";
import { useMemo, useState } from "react";
import { useInfiniteQuery, useQuery } from "react-query";
import { config as isConfig, mainUrl } from "../../../api/api";
import Button from "../../Button/Button";

const DiscountPopup = (props) => {
  const { setAllDiscount, allDiscount, setDiscount_ids, discount_ids } = props;
  const [searchDiscount, setSearchDiscount] = useState("");

  const {
    data,
    error,
    isFetching,
  } = useInfiniteQuery(["discounts", searchDiscount], ({ pageParam = 1 }) => {
    const keyword = searchDiscount.trim();
    const filterQuery = keyword
      ? `&filter[name]=${encodeURIComponent(keyword)}`
      : "";

    return axios
      .get(`${mainUrl}/discounts?page=${pageParam}${filterQuery}`, isConfig)
      .then((res) => res.data)
      .catch((error) => error.response);
  }, {
    getPreviousPageParam: (firstPage) => firstPage.previousId ?? undefined,
    getNextPageParam: (lastPage) => {
      if (lastPage.links.next !== null) {
        return lastPage.meta.current_page + 1;
      }
      return undefined;
    },
    refetchOnWindowFocus: (query) => query.state.status !== "error",
    staleTime: Infinity
  });

  const {
    data: featuredDiscount,
    isFetching: isFetchingFeaturedDiscount,
    error: featuredDiscountError,
  } = useQuery(
    ["featured-discount"],
    () =>
      axios
        .get(
          `${mainUrl}/discounts?filter[is_progresive_discounts]=1`,
          isConfig
        )
        .then((res) => {
          const featuredDiscountList = Array.isArray(res?.data?.data)
            ? res.data.data
            : Array.isArray(res?.data)
            ? res.data
            : [];

          return featuredDiscountList[0] || null;
        })
        .catch(() => null),
    {
      staleTime: Infinity,
    }
  );

  const resultDiscount = useMemo(() => {
    return dataFromPaginated(data, featuredDiscount?.id);
  }, [data, featuredDiscount?.id]);

  const handleClick = (discount, discount_id) => {
    if (!discount_ids.includes(discount_id)) {
      setAllDiscount([...allDiscount, discount]);
      setDiscount_ids([...discount_ids, discount_id]);
    }
  };

  const handleDeleteDiscount = (discount, discount_id) => {
    setAllDiscount(allDiscount.filter((item) => item.id !== discount.id));
    setDiscount_ids(discount_ids.filter((item) => item !== discount_id));
  };

  if (error || featuredDiscountError) {
    return <h4>Terjadi Kesalahan Pada Server</h4>;
  }

  return (
    <div className="discount-popup" id="discount-popup" style={{ zIndex: "150" }}>
      <div className="discount-popup__body">
        <div className="discount-popup__header">
          <h2>Discount</h2>
          <p>Pilih discount yang ingin diterapkan ke order ini.</p>
        </div>

        <div className="discount-code-form discount-popup__search">
          <form className="d-flex align-items-center" onSubmit={(e) => e.preventDefault()}>
            <img src="/Asset/Voucher.svg" alt="voucher" />
            <input
              type="text"
              id="voucher-code"
              name="voucher-code"
              className="form-control discount-popup__input"
              placeholder="Masukan kode atau nama discount"
              value={searchDiscount}
              onChange={(e) => setSearchDiscount(e.target.value)}
            />
          </form>
        </div>

        <div className="discount-popup__list">
          {isFetchingFeaturedDiscount ? (
            <div className="discount-popup__state discount-popup__state--featured">
              Memuat priority discount...
            </div>
          ) : featuredDiscount?.id ? (
            <div className="discount-popup__featured">
              {renderDiscountItem({
                discount: featuredDiscount,
                discount_ids,
                handleClick,
                handleDeleteDiscount,
                isFeatured: true,
              })}
            </div>
          ) : null}

          {isFetching && !resultDiscount?.length ? (
            <div className="discount-popup__state">Memuat discount...</div>
          ) : resultDiscount?.length ? (
            resultDiscount.map((discounts) => {
              return discounts?.map((discount) => {
                return renderDiscountItem({
                  discount,
                  discount_ids,
                  handleClick,
                  handleDeleteDiscount,
                });
              });
            })
          ) : (
            <div className="discount-popup__state">Discount tidak ditemukan.</div>
          )}
        </div>

        <div className="discount-popup__footer">
          <div onClick={() => props.setPopup(false)}>
            <Button title="Done" btnStyle={"primary-btn"} btnWidth="100%" />
          </div>
        </div>
      </div>
    </div>
  );
};

export default DiscountPopup;

const renderDiscountItem = ({
  discount,
  discount_ids,
  handleClick,
  handleDeleteDiscount,
  isFeatured = false,
}) => {
  const isSelected = discount_ids.includes(discount.id);

  return (
    <div
      className={`discount-popup__item ${isFeatured ? "discount-popup__item--featured" : ""} ${isSelected ? "discount-popup__item--selected" : ""}`.trim()}
      key={discount.id}
    >
      <div className="discount-popup__item-copy">
        <div className="discount-popup__item-head">
          <p className="discount-popup__item-title">{discount.name}</p>
          {isFeatured && (
            <span className="discount-popup__badge">WAJIB (MIN. NOMINAL TERTENTU)</span>
          )}
        </div>
        <p className="discount-popup__item-description">
          {discount.description || "Tidak ada deskripsi discount."}
        </p>
        <p className="discount-popup__item-meta">ID: {discount.id}</p>
      </div>
      <div
        className="discount-popup__item-action"
        onClick={() =>
          isSelected
            ? handleDeleteDiscount(discount, discount.id)
            : handleClick(discount, discount.id)
        }
      >
        <Button
          title={isSelected ? "Delete" : "Apply"}
          btnStyle={isSelected ? "btn-danger" : "primary-btn"}
        />
      </div>
    </div>
  );
};

const dataFromPaginated = (paginationData, excludedDiscountId) => {
  if (!paginationData) return null;
  const newArr = [];
  paginationData?.pages?.forEach((d) => {
    newArr.push(
      d.data?.filter((discount) => discount.id !== excludedDiscountId)
    );
  });
  return newArr;
};
