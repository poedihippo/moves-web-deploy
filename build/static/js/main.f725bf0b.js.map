import axios from "axios";
import React, { useState } from "react";
import { mainUrl } from "../../../api/api";
import cityList from "../../../api/citiesNew";
import countryList from "../../../api/countries";
import districtList from "../../../api/district";
import provinceList from "../../../api/provincesNew";
import subdistrictList from "../../../api/subdistrict";
import { isValidate } from "../../../lib/Validate";
import Button from "../../Button/Button";
import AddLeadForm from "../../forms/AddLeadForm";
import "./PopUpStyles.scss";

const NewCustomerPopup = (props, { setUpdate, update }) => {
  const [customer, setCustomer] = useState();
  const [isNewCustomer, setIsNewCustomer] = useState(false);
  const [showAddressForm, setShowAddressForm] = useState(false);
  const [createdCustomerId, setCreatedCustomerId] = useState(null);

  const [errorText, setErrorText] = useState(null);

  // Basic Information
  const [first_name, setFirst_name] = useState("");
  const [last_name, setLast_name] = useState("");
  const [date_of_birth, setDate_of_birth] = useState("");
  const [title, setTitle] = useState("");
  const [pic_name, setPic_name] = useState("");
  const [hasEmail, setHasEmail] = useState(false);
  const [email, setEmail] = useState("");
  const [phone, setPhone] = useState("");

  // Addresses
  const [address_line_1, setAddress_line_1] = useState("");
  const [address_line_2, setAddress_line_2] = useState("");
  const [address_line_3, setAddress_line_3] = useState("");
  const [province, setProvince] = useState();
  const [city, setCity] = useState();
  const [district, setDistrict] = useState();
  const [subDistrict, setSubDistrict] = useState("");
  const [country, setCountry] = useState("Indonesia");
  const [type, setType] = useState("");
  const [isDelivery, setIsDelivery] = useState(true);

  // validation
  const [titleValidation, setTitleValidation] = useState(false);
  const [picNameValidation, setPicNameValidation] = useState(false);
  const [firstNameValidation, setFirstNameValidation] = useState(false);
  const [emailValidation, setEmailValidation] = useState(false);
  const [phoneValidation, setPhoneValidation] = useState(false);
  const [address1Validation, setAddress1Validation] = useState(false);
  const [typeValidation, setTypeValidation] = useState(false);

  const showPicNameField = ["PT", "CV"].includes(title);
  const showPersonalNameFields = ["MR", "MS", "MRS"].includes(title);

  const getConfig = () => ({
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${localStorage.token}`,
      Accept: "application/json, text-plain, */*",
    },
  });

  const getErrorMessage = () => {
    if (!errorText) {
      return "";
    }

    if (typeof errorText === "string") {
      return errorText;
    }

    if (errorText.message) {
      return errorText.message;
    }

    if (errorText.errors) {
      const firstError = Object.values(errorText.errors).find(
        (value) => Array.isArray(value) && value.length > 0
      );

      if (firstError) {
        return firstError[0];
      }
    }

    return "";
  };

  const getCustomerPayload = () => ({
    first_name: first_name,
    last_name: last_name && last_name,
    date_of_birth: date_of_birth && date_of_birth,
    title: title,
    ...(showPicNameField && { pic_name: pic_name }),
    ...(hasEmail && { email: email }),
    phone: phone,
  });

  const getAddressPayload = (customerId) => ({
    addressLine1: address_line_1,
    addressLine2: address_line_2,
    addressLine3: address_line_3,
    city: city ? city.name : "",
    province: province ? province.name : "",
    country: country && country,
    type: type,
    customerId: customerId,
    district: district ? district.name : "",
    sub_district: subDistrict && subDistrict,
    address_line_1: address_line_1,
    address_line_2: address_line_2 && address_line_2,
    address_line_3: address_line_3 && address_line_3,
    customer_id: customerId,
  });

  const resetCustomerFields = () => {
    setFirst_name("");
    setLast_name("");
    setDate_of_birth("");
    setTitle("");
    setPic_name("");
    setHasEmail(false);
    setEmail("");
    setPhone("");
    setTitleValidation(false);
    setPicNameValidation(false);
    setFirstNameValidation(false);
    setEmailValidation(false);
    setPhoneValidation(false);
  };

  const resetAddressFields = () => {
    setAddress_line_1("");
    setAddress_line_2("");
    setAddress_line_3("");
    setProvince();
    setCity();
    setDistrict();
    setSubDistrict("");
    setCountry("Indonesia");
    setType("");
    setIsDelivery(false);
    setAddress1Validation(false);
    setTypeValidation(false);
  };

  const renderAddressFields = (showDeliveryToggle = false) => (
    <>
      <div className="mt-3">
        <label>
          Address Line 1<span>*</span>
        </label>
        <input
          type="text"
          id="address"
          name="address"
          className={`form-control ${address1Validation &&
            isValidate(address_line_1) &&
            "is-invalid"
            }`}
          placeholder="Input address here"
          style={{ height: "41px" }}
          value={address_line_1}
          onChange={(e) => setAddress_line_1(e.target.value)}
        />
        {isValidate(address_line_1) && (
          <div className="invalid-feedback">Address is empty.</div>
        )}
      </div>
      <div className="mt-3">
        <label>Address Line 2</label>
        <input
          type="text"
          id="address2"
          name="address2"
          className="form-control"
          placeholder="Input address here"
          style={{ height: "41px" }}
          value={address_line_2}
          onChange={(e) => setAddress_line_2(e.target.value)}
        />
      </div>
      <div className="mt-3">
        <label>Address Line 3</label>
        <input
          type="text"
          id="address3"
          name="address3"
          className="form-control"
          placeholder="Input address here"
          style={{ height: "41px" }}
          value={address_line_3}
          onChange={(e) => setAddress_line_3(e.target.value)}
        />
      </div>

      <div className="mt-3">
        <label>Provinsi</label>
        <select
          className="form-select"
          id="province"
          name="province"
          style={{ height: "41px" }}
          value={province ? JSON.stringify(province) : ""}
          onChange={(e) => {
            setProvince(
              e.target.value ? JSON.parse(e.target.value) : undefined
            );
            setCity();
            setDistrict();
            setSubDistrict("");
          }}
        >
          <option value="">Pilih provinsi</option>
          {provinceList.map((province) => {
            return (
              <option
                value={JSON.stringify({
                  id: province.id,
                  name: province.provinsi,
                })}
                key={province.id}
              >
                {province.provinsi}
              </option>
            );
          })}
        </select>
      </div>
      <div className="mt-3">
        <label>Kota</label>
        <select
          className="form-select"
          id="city"
          name="city"
          style={{ height: "41px" }}
          value={city ? JSON.stringify(city) : ""}
          onChange={(e) => {
            setCity(
              e.target.value ? JSON.parse(e.target.value) : undefined
            );
            setDistrict();
            setSubDistrict("");
          }}
        >
          <option value="">Pilih Kota</option>
          {cityList
            .filter((city) =>
              province ? city.provinsi_id === province.id : false
            )
            .map((city) => {
              return (
                <option
                  value={JSON.stringify({
                    id: city.id,
                    name: city.kabupaten_kota,
                  })}
                  key={city.id}
                >
                  {city.kabupaten_kota}
                </option>
              );
            })}
        </select>
      </div>
      <div className="mt-3">
        <label>Kecamatan</label>
        <select
          className="form-select"
          id="district"
          name="district"
          style={{ height: "41px" }}
          value={district ? JSON.stringify(district) : ""}
          onChange={(e) => {
            setDistrict(
              e.target.value ? JSON.parse(e.target.value) : undefined
            );
            setSubDistrict("");
          }}
        >
          <option value="">Pilih Kecamatan</option>
          {districtList
            .filter((district) =>
              city ? district.kabkot_id === city.id : false
            )
            .map((district) => {
              return (
                <option
                  value={JSON.stringify({
                    id: district.id,
                    name: district.kecamatan,
                  })}
                  key={district.id}
                >
                  {district.kecamatan}
                </option>
              );
            })}
        </select>
      </div>
      <div className="mt-3">
        <label>Kelurahan</label>
        <select
          className="form-select"
          id="subDistrict"
          name="subDistrict"
          style={{ height: "41px" }}
          value={subDistrict}
          onChange={(e) => setSubDistrict(e.target.value)}
        >
          <option value="">Pilih Kelurahan</option>
          {subdistrictList
            .filter((subdistrict) =>
              district ? subdistrict.kecamatan_id === district.id : false
            )
            .map((subdistrict) => {
              const subDistrictLabel = `${subdistrict.kelurahan} (${subdistrict.kd_pos})`;

              return (
                <option value={subDistrictLabel} key={subdistrict.id}>
                  {subDistrictLabel}
                </option>
              );
            })}
        </select>
      </div>
      <div className="mt-3">
        <label>Negara</label>
        <select
          className="form-select"
          id="country"
          name="country"
          style={{ height: "41px" }}
          value={country}
          onChange={(e) => setCountry(e.target.value)}
        >
          <option value="">Pilih Negara</option>
          {countryList.map((country, i) => {
            return (
              <option value={country} key={i}>
                {country}
              </option>
            );
          })}
        </select>
      </div>
      <div className="mt-3">
        <label>
          Address Type<span>*</span>
        </label>
        <select
          className={`form-select ${typeValidation && isValidate(type) && "is-invalid"
            }`}
          id="addressType"
          name="addressType"
          style={{ height: "41px" }}
          value={type}
          onChange={(e) => setType(e.target.value)}
        >
          <option value="">Select Address Type</option>
          <option value={"ADDRESS"}>Address</option>
          <option value={"DELIVERY"}>Delivery</option>
          <option value={"BILLING"}>Billing</option>
        </select>
        {isValidate(type) && (
          <div className="invalid-feedback">
            Please select a valid address type.
          </div>
        )}
      </div>
      {showDeliveryToggle && (
        <div className="mt-3">
          <div className="form-check">
            <input
              type="checkbox"
              id="is-delivery"
              name="is-delivery"
              className="form-check-input"
              checked={isDelivery}
              onChange={(e) => setIsDelivery(e.target.checked)}
            />
            <label className="form-check-label" htmlFor="is-delivery">
              Is the billing address the same as delivery address?
            </label>
          </div>
        </div>
      )}
    </>
  );

  const createCustomerAndAddress = async () => {
    try {
      const res = await axios.post(
        `${mainUrl}/customers/addresses`,
        {
          ...getCustomerPayload(),
          ...getAddressPayload(undefined),
        },
        getConfig()
      );
      setCustomer(res.data.data);
      setIsNewCustomer(true);
      resetCustomerFields();
      resetAddressFields();
      setErrorText(null);
    } catch (error) {
      console.error(error);
      setErrorText(error.response?.data || error.message);
    }
  };

  const createCustomerOnly = async () => {
    try {
      const res = await axios.post(
        `${mainUrl}/customers`,
        getCustomerPayload(),
        getConfig()
      );
      const createdCustomer = res.data.data ? res.data.data : res.data;
      const customerId = res.data.id
        ? res.data.id
        : res.data.data && res.data.data.id
          ? res.data.data.id
          : createdCustomer && createdCustomer.id;

      setCustomer(createdCustomer);
      setCreatedCustomerId(customerId);
      setShowAddressForm(true);
      setErrorText(null);
      window.scrollTo(0, 0);
    } catch (error) {
      console.error(error);
      setErrorText(error.response?.data || error.message);
    }
  };

  const createAddress = async () => {
    try {
      await axios.post(
        `${mainUrl}/addresses`,
        getAddressPayload(createdCustomerId),
        getConfig()
      );
      setShowAddressForm(false);
      setIsNewCustomer(true);
      setCreatedCustomerId(null);
      resetCustomerFields();
      resetAddressFields();
      setErrorText(null);
      window.scrollTo(0, 0);
    } catch (error) {
      console.error(error);
      setErrorText(error.response?.data || error.message);
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();

    isValidate(title) ? setTitleValidation(true) : setTitleValidation(false);
    showPicNameField && isValidate(pic_name)
      ? setPicNameValidation(true)
      : setPicNameValidation(false);
    isValidate(first_name)
      ? setFirstNameValidation(true)
      : setFirstNameValidation(false);
    hasEmail && isValidate(email)
      ? setEmailValidation(true)
      : setEmailValidation(false);
    isValidate(phone) ? setPhoneValidation(true) : setPhoneValidation(false);

    if (isDelivery) {
      isValidate(address_line_1)
        ? setAddress1Validation(true)
        : setAddress1Validation(false);
      isValidate(type) ? setTypeValidation(true) : setTypeValidation(false);
    } else {
      setAddress1Validation(false);
      setTypeValidation(false);
    }

    if (
      !isValidate(first_name) &&
      !isValidate(title) &&
      (!showPicNameField || !isValidate(pic_name)) &&
      (!hasEmail || !isValidate(email)) &&
      !isValidate(phone) &&
      (!isDelivery || (!isValidate(address_line_1) && !isValidate(type)))
    ) {
      if (isDelivery) {
        createCustomerAndAddress();
      } else {
        createCustomerOnly();
      }
      window.scrollTo(0, 0);
    }
  };

  const handleAddressSubmit = (e) => {
    e.preventDefault();

    isValidate(address_line_1)
      ? setAddress1Validation(true)
      : setAddress1Validation(false);
    isValidate(type) ? setTypeValidation(true) : setTypeValidation(false);

    if (
      createdCustomerId &&
      !isValidate(address_line_1) &&
      !isValidate(type)
    ) {
      createAddress();
    }
  };

  return (
    <div className="newcustomer-popup-card">
      {isNewCustomer ? (
        <AddLeadForm
          newCustomer={customer ? customer : ""}
          setPopup={props.setPopup}
          setUpdate={props.setUpdate}
          update={props.update}
          setIsNewCustomer={setIsNewCustomer}
          isNewCustomer={isNewCustomer}
        />
      ) : showAddressForm ? (
        <form onSubmit={handleAddressSubmit}>
          <h3>Address Information</h3>
          <hr />
          <div className=" mt-4 mb-4">
            {getErrorMessage() ? (
              <div className="alert alert-danger" role="alert">
                {getErrorMessage()}
              </div>
            ) : (
              ""
            )}
            {renderAddressFields(false)}
          </div>
          <div>
            <Button
              title={"Submit"}
              icon={""}
              btnWidth={"100%"}
              btnStyle={"primary-btn"}
            />
          </div>
        </form>
      ) : (
        <form onSubmit={handleSubmit}>
          <h3>Basic Information</h3>
          <hr />
          <div className=" mt-4 mb-4">
            {getErrorMessage() ? (
              <div className="alert alert-danger" role="alert">
                {getErrorMessage()}
              </div>
            ) : (
              ""
            )}
            <div className="mt-3">
              <label>
                Title<span className="important">*</span>
              </label>
              <select
                className={`form-select ${titleValidation && isValidate(title) && "is-invalid"
                  } `}
                name="title"
                id="title"
                style={{ height: "41px" }}
                value={title}
                onChange={(e) => {
                  const nextTitle = e.target.value;
                  setTitle(nextTitle);

                  if (!["PT", "CV"].includes(nextTitle)) {
                    setPic_name("");
                    setPicNameValidation(false);
                  }

                  if (!["MR", "MS", "MRS"].includes(nextTitle)) {
                    setLast_name("");
                  }
                }}
              >
                <option value="">Select Title</option>
                <option value={"MR"}>Mr.</option>
                <option value={"MS"}>Ms.</option>
                <option value={"MRS"}>Mrs.</option>
                <option value={"PT"}>PT</option>
                <option value={"CV"}>CV</option>
              </select>
              {isValidate(title) && (
                <div className="invalid-feedback">
                  Please select a valid title.
                </div>
              )}
            </div>
        
            {showPersonalNameFields ? (
              <div className="mt-3">
                <label>
                  Name<span className="important">*</span>
                </label>
                <div className="d-flex gap-2">
                  <div className="w-100">
                    <input
                      type="text"
                      id="firstName"
                      name="firstName"
                      className={`form-control ${firstNameValidation &&
                        isValidate(first_name) &&
                        "is-invalid"
                        }`}
                      placeholder="Input first name here"
                      value={first_name}
                      onChange={(e) => setFirst_name(e.target.value)}
                      style={{ height: "41px" }}
                    />
                    {isValidate(first_name) && (
                      <div className="invalid-feedback">
                        Please insert first name.
                      </div>
                    )}
                  </div>
                  <div className="w-100">
                    <input
                      type="text"
                      id="lastName"
                      name="lastName"
                      className="form-control"
                      placeholder="Input last name here"
                      value={last_name}
                      onChange={(e) => setLast_name(e.target.value)}
                      style={{ height: "41px" }}
                    />
                  </div>
                </div>
              </div>
            ) : (
              <div className="mt-3">
                <label>
                  Name<span className="important">*</span>
                </label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  className={`form-control ${firstNameValidation &&
                    isValidate(first_name) &&
                    "is-invalid"
                    }`}
                  placeholder="Input name here"
                  value={first_name}
                  onChange={(e) => setFirst_name(e.target.value)}
                  style={{ height: "41px" }}
                />
                {isValidate(first_name) && (
                  <div className="invalid-feedback">Please insert name.</div>
                )}
              </div>
            )}
                {showPicNameField && (
              <div className="mt-3">
                <label>
                  PIC Name<span className="important">*</span>
                </label>
                <input
                  type="text"
                  id="pic-name"
                  name="pic-name"
                  className={`form-control ${picNameValidation &&
                    isValidate(pic_name) &&
                    "is-invalid"
                    }`}
                  placeholder="Input PIC name here"
                  value={pic_name}
                  onChange={(e) => setPic_name(e.target.value)}
                  style={{ height: "41px" }}
                />
                {isValidate(pic_name) && (
                  <div className="invalid-feedback">
                    Please insert PIC name.
                  </div>
                )}
              </div>
            )}
            <div className="mt-3">
              <label>Date of Birth</label>
              <input
                type="date"
                id="DoB"
                name="DoB"
                className="form-control"
                placeholder="Start Month"
                value={date_of_birth}
                onChange={(e) => setDate_of_birth(e.target.value)}
                style={{ height: "41px" }}
              />
            </div>
            <div className="mt-3">
              <label>
                Phone Number<span className="important">*</span>
              </label>
              <input
                type="text"
                id="phone-number"
                name="phone-number"
                className={`form-control ${phoneValidation && isValidate(phone) && "is-invalid"
                  }`}
                placeholder="Input phone number here"
                value={phone}
                onChange={(e) => setPhone(e.target.value)}
                style={{ height: "41px" }}
              />
              {isValidate(phone) && (
                <div className="invalid-feedback">
                  Please insert a valid Phone Number.
                </div>
              )}
            </div>
            <div className="mt-3">
              <div className="form-check">
                <input
                  type="checkbox"
                  id="has-email"
                  name="has-email"
                  className="form-check-input"
                  checked={hasEmail}
                  onChange={(e) => {
                    const checked = e.target.checked;
                    setHasEmail(checked);

                    if (!checked) {
                      setEmail("");
                      setEmailValidation(false);
                    }
                  }}
                />
                <label className="form-check-label" htmlFor="has-email">
                  Does the customer have an email?
                </label>
              </div>
            </div>
            {hasEmail && (
              <div className="mt-3">
                <label>
                  Email<span className="important">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  className={`form-control ${emailValidation && isValidate(email) && "is-invalid"
                    }`}
                  placeholder="Input email here"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  style={{ height: "41px" }}
                />
                {isValidate(email) && (
                  <div className="invalid-feedback">
                    Please insert a valid email.
                  </div>
                )}
              </div>
            )}
          </div>
          <h3>Address Information</h3>
          <hr />
          <div className=" mt-4 mb-4">{renderAddressFields(true)}</div>
          <div>
            <Button
              title={"Submit"}
              icon={""}
              btnWidth={"100%"}
              btnStyle={"primary-btn"}
            />
          </div>
        </form>
      )}
    </div>
  );
};

export default NewCustomerPopup;
