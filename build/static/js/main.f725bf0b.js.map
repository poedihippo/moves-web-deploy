import React, { useEffect, useState } from "react";
import { connect, useDispatch } from "react-redux";
import { Link, useHistory, useLocation } from "react-router-dom";
import { QueryClient } from "react-query";
import { logout } from "../../../redux/action/auth";
import Loaded from "../../Loaded/Loaded";
import "./Sidebar.scss";
import { canAccessOrderFf } from "../../../pages/dahsboards/order-ff/orderFfAccess";

const REPORT_DEAL_ITEMS = [
  { name: "Quotation", href: "/dashboard/report-deals-detail/quotation" },
  { name: "Settlement", href: "/dashboard/report-deals-detail/settlement" },
  { name: "Deals", href: "/dashboard/report-deals-detail/deals" },
  { name: "Partial", href: "/dashboard/report-deals-detail/partial" },
  { name: "Down Payment", href: "/dashboard/report-deals-detail/down-payment" },
  { name: "Cancelled", href: "/dashboard/report-deals-detail/cancelled" },
];

const APPROVAL_ITEMS = [
  { label: "Need My Approval", path: "/dashboard/approval/WAITING_APPROVAL" },
  { label: "Approved", path: "/dashboard/approval/APPROVED" },
  { label: "Rejected", path: "/dashboard/approval/REJECTED" },
  { label: "All", path: "/dashboard/approval/ALL" },
];

const CRM_ITEMS = [
  { label: "Unhandled", path: "/dashboard/customers/unhandled" },
  { label: "Leads", path: "/dashboard/customers/leads" },
  { label: "Prospect", path: "/dashboard/customers/prospect" },
  { label: "Deal", path: "/dashboard/customers/deal" },
  { label: "Drop", path: "/dashboard/customers/drop" },
  { label: "Designer", path: "/dashboard/customers/designer" },
];

const Sidebar = ({
  promo: { promoCategories },
  product: { brands },
  auth: { user },
}) => {
  const history = useHistory();
  const dispatch = useDispatch();
  const location = useLocation();
  const { pathname } = location;

  const [productBar, setProductBar] = useState(false);
  const [promoBar, setPromoBar] = useState(false);
  const [crmBar, setCrmBar] = useState(false);
  const [reportBar, setReportBar] = useState(false);
  const [approvalBar, setApprovalBar] = useState(false);
  const [childBar, setChildBar] = useState({
    reportDetail: false,
  });

  const userRole = user?.data?.as?.toLowerCase();
  const reportDetailActive = REPORT_DEAL_ITEMS.some((item) => item.href === pathname);
  const approvalActive = pathname.startsWith("/dashboard/approval/");
  const reportActive =
    pathname === "/dashboard/new-report-leads" || reportDetailActive;
  const productActive = pathname.startsWith("/dashboard/product");
  const promoActive = pathname.startsWith("/dashboard/promo-categories");
  const crmActive = pathname.startsWith("/dashboard/customers");
  const orderFfActive = pathname.startsWith("/dashboard/order-ff");

  useEffect(() => {
    if (approvalActive) {
      setApprovalBar(true);
    }
    if (reportActive) {
      setReportBar(true);
    }
    if (reportDetailActive) {
      setChildBar((prev) => ({
        ...prev,
        reportDetail: true,
      }));
    }
    if (productActive) {
      setProductBar(true);
    }
    if (promoActive) {
      setPromoBar(true);
    }
    if (crmActive) {
      setCrmBar(true);
    }
    window.scrollTo(0, 0);
  }, [
    approvalActive,
    crmActive,
    productActive,
    promoActive,
    reportActive,
    reportDetailActive,
  ]);

  const handleGoToSeeDetails = () => {
    history.push({
      pathname: `/dashboard/dashboard-see-detail/${user?.data?.id}/${userRole}`,
      state: {
        filterDate: { start: "", end: "" },
        idCompany: "",
      },
    });
  };

  const handleProductSectionClick = () => {
    setProductBar((prev) => !prev);
    if (pathname !== "/dashboard/product") {
      history.push("/dashboard/product");
    }
  };

  const handlePromoSectionClick = () => {
    setPromoBar((prev) => !prev);
    if (pathname !== "/dashboard/promo-categories") {
      history.push("/dashboard/promo-categories");
    }
  };

  const handleLogOut = () => {
    localStorage.removeItem("data_user_log_new");
    localStorage.removeItem("ally-supports-cache");
    localStorage.removeItem("chakra-ui-color-mode");
    localStorage.removeItem("user_type_log");
    localStorage.removeItem("company_id");
    localStorage.removeItem("user_id_log");
    localStorage.removeItem("auth");
    localStorage.removeItem("user_type_leads_filter");
    localStorage.removeItem("channels_leads_filter");
    localStorage.removeItem("loading_pipelines");
    localStorage.removeItem("token");

    const queryClient = new QueryClient();
    queryClient.clear();

    dispatch(logout());
    history.push("/login");
  };

  const renderArrow = (isOpen) => (
    <img
      src={
        isOpen ? "/Asset/Sidebar/arrow up.png" : "/Asset/Sidebar/arrow down.png"
      }
      alt="arrow"
      className={`arrow-bar ${isOpen ? "is-open" : ""}`}
    />
  );

  const renderSubMenuLink = (label, path, extraClassName = "") => (
    <div className="nav-item" key={path}>
      <Link
        className={`nav-link sub-link ${pathname === path ? "active" : ""} ${extraClassName}`.trim()}
        aria-current="page"
        to={path}
      >
        <span>{label}</span>
      </Link>
    </div>
  );

  return promoCategories && brands && user ? (
    <nav
      id="sidebarMenu"
      className="col-md-3 col-lg-2 d-md-block bg-light sidebar"
    >
      <div className="position-sticky sidebar-shell">
        <div className="sidebar-logo">
          <img src="/Asset/MOVES LOGO-01 1.png" alt="Logo" />
        </div>
        <div className="sidebar-logo-mobile">
          <img src="/Asset/fav.png" alt="Logo" />
        </div>

        <ul className="nav flex-column sidebar-nav">
          <li className="nav-item">
            <Link
              className={`nav-link ${pathname === "/dashboard" ? "active" : ""}`}
              aria-current="page"
              to="/dashboard"
            >
              <span className="nav-link-main">
                <img src="/Asset/Sidebar/Dashboard.png" alt="dashboard" />
                <span className="menu-title">Dashboard</span>
              </span>
            </Link>
          </li>

          {userRole !== "sales" && (
            <li className="dropdown">
              <button
                type="button"
                className={`nav-link nav-link-button ${approvalActive ? "active-parent" : ""}`}
                aria-expanded={approvalBar}
                onClick={() => setApprovalBar((prev) => !prev)}
              >
                <span className="nav-link-main">
                  <img src="/Asset/Sidebar/time.png" alt="approval" />
                  <span className="menu-title">Approval</span>
                </span>
                {renderArrow(approvalBar)}
              </button>
              <div className={`sub-menu ${approvalBar ? "dd-active" : ""}`}>
                {APPROVAL_ITEMS.map((item) =>
                  renderSubMenuLink(item.label, item.path)
                )}
              </div>
            </li>
          )}

          <li className="dropdown">
            <button
              type="button"
              className={`nav-link nav-link-button ${reportActive ? "active-parent" : ""}`}
              aria-expanded={reportBar}
              onClick={() => setReportBar((prev) => !prev)}
            >
              <span className="nav-link-main">
                <img src="/Asset/Sidebar/Report.png" alt="report" />
                <span className="menu-title">Report</span>
              </span>
              {renderArrow(reportBar)}
            </button>
            <div className={`sub-menu ${reportBar ? "dd-active" : ""}`}>
              {userRole !== "sales" &&
                renderSubMenuLink("Leads", "/dashboard/new-report-leads")}

              <div className="nav-item nested-dropdown">
                <button
                  type="button"
                  className={`nav-link nav-link-button nav-link-nested ${reportDetailActive ? "active-parent" : ""}`}
                  aria-expanded={childBar.reportDetail}
                  onClick={() =>
                    setChildBar((prev) => ({
                      ...prev,
                      reportDetail: !prev.reportDetail,
                    }))
                  }
                >
                  <span className="menu-title">Report Deals Detail</span>
                  {renderArrow(childBar.reportDetail)}
                </button>
                <div
                  className={`sub-menu sub-menu-nested ${
                    childBar.reportDetail ? "dd-active" : ""
                  }`}
                >
                  {REPORT_DEAL_ITEMS.map((item) =>
                    renderSubMenuLink(item.name, item.href, "sub-link-deep")
                  )}
                </div>
              </div>

              <div className="nav-item">
                <button
                  type="button"
                  className="nav-link nav-link-button nav-link-plain"
                  onClick={handleGoToSeeDetails}
                >
                  <span className="menu-title">Dashboard Detail</span>
                </button>
              </div>
            </div>
          </li>

          <li className="dropdown">
            <button
              type="button"
              className={`nav-link nav-link-button ${productActive ? "active-parent" : ""}`}
              aria-expanded={productBar}
              onClick={handleProductSectionClick}
            >
              <span className="nav-link-main">
                <img src="/Asset/Sidebar/Produk.png" alt="produk" />
                <span className="menu-title">Product</span>
              </span>
              {renderArrow(productBar)}
            </button>
            <div className={`sub-menu ${productBar ? "dd-active" : ""}`}>
              {brands?.data?.map((brand) => (
                <div className="nav-item" key={brand.id}>
                  <Link
                    className={`nav-link sub-link ${
                      pathname ===
                      `/dashboard/product/product_by_brand/${brand.name}/${brand.id}`
                        ? "active"
                        : ""
                    }`}
                    aria-current="page"
                    to={`/dashboard/product/product_by_brand/${brand.name}/${brand.id}`}
                  >
                    <span>{brand.name}</span>
                  </Link>
                </div>
              ))}
            </div>
          </li>

          <li className="dropdown">
            <button
              type="button"
              className={`nav-link nav-link-button ${promoActive ? "active-parent" : ""}`}
              aria-expanded={promoBar}
              onClick={handlePromoSectionClick}
            >
              <span className="nav-link-main">
                <img src="/Asset/Sidebar/Promo.png" alt="promo" />
                <span className="menu-title">Promo</span>
              </span>
              {renderArrow(promoBar)}
            </button>
            <div className={`sub-menu ${promoBar ? "dd-active" : ""}`}>
              {promoCategories?.data?.map((category) => (
                <div className="nav-item" key={category.id}>
                  <Link
                    className={`nav-link sub-link ${
                      pathname ===
                      `/dashboard/promo-categories/${category.id}/${category.name
                        ?.replace(/[^\w\s]/g, "")
                        ?.split(" ")
                        ?.join("-")}`
                        ? "active"
                        : ""
                    }`}
                    aria-current="page"
                    to={`/dashboard/promo-categories/${category.id}/${category.name
                      ?.replace(/[^\w\s]/g, "")
                      ?.split(" ")
                      ?.join("-")}`}
                  >
                    <span>{category.name}</span>
                  </Link>
                </div>
              ))}
            </div>
          </li>

          <li className="dropdown">
            <button
              type="button"
              className={`nav-link nav-link-button ${crmActive ? "active-parent" : ""}`}
              aria-expanded={crmBar}
              onClick={() => setCrmBar((prev) => !prev)}
            >
              <span className="nav-link-main">
                <img src="/Asset/Sidebar/Customer.png" alt="crm" />
                <span className="menu-title">CRM</span>
              </span>
              {renderArrow(crmBar)}
            </button>
            <div className={`sub-menu ${crmBar ? "dd-active" : ""}`}>
              {CRM_ITEMS.map((item) => renderSubMenuLink(item.label, item.path))}
            </div>
          </li>

          {canAccessOrderFf(user) && (
          <li className="nav-item">
            <Link
              className={`nav-link ${orderFfActive ? "active" : ""}`}
              aria-current="page"
              to="/dashboard/order-ff"
            >
              <span className="nav-link-main">
                <img src="/Asset/Sidebar/Report.png" alt="order ff" />
                <span className="menu-title">Order FF</span>
              </span>
            </Link>
          </li>
          )}

          <li className="nav-item">
            <button
              type="button"
              className="nav-link nav-link-button nav-link-plain"
              aria-current="page"
              onClick={handleLogOut}
            >
              <span className="nav-link-main">
                <img src="/Asset/Sidebar/Group 1765.png" alt="sign out" />
                <span className="menu-title">Sign Out</span>
              </span>
            </button>
          </li>
        </ul>
      </div>
    </nav>
  ) : (
    <div
      style={{
        position: "fixed",
        top: "0",
        right: "0",
        zIndex: "120",
        width: "100vw",
      }}
    >
      <Loaded />
    </div>
  );
};

const mapStateToProps = (state) => ({
  auth: state.auth,
  product: state.product,
  promo: state.promo,
});

export default connect(mapStateToProps)(Sidebar);
